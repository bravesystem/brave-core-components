                        function restoreDefaultUI(restrictions) {

            const type = (window._currentRestrictionType || "").toUpperCase();

            const isSelect =
                type.includes("SELECT ONE") ||
                type.includes("SELECT MANY");

            const useDefault = document.getElementById("useDefault");
            const manualToggle = document.getElementById("isManual");

            const manualToggleContainer = document.getElementById("manualToggleContainer");
            const manualValueContainer = document.getElementById("manualValueContainer");
            const defaultQuestionContainer = document.getElementById("defaultQuestionContainer");

            const dropdown = document.getElementById("defaultValueSelect");
            const manualInput = document.getElementById("defaultValue");
            const readonlyToggle = document.getElementById("readonlyToggle");
            const errorInput = document.getElementById("errorMessage");

            /* SELECT ONE / SELECT MANY BEHAVIOR */

            if (isSelect) {

                if (manualToggleContainer) manualToggleContainer.style.display = "none";
                if (manualValueContainer) manualValueContainer.style.display = "none";

                if (restrictions?.defaultValue) {

                    if (useDefault) useDefault.checked = true;

                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "";

                    if (dropdown) dropdown.value = restrictions.defaultValue;

                }

            }

            /* TEXT / INT / NUMERIC BEHAVIOR */

            else {

                if (restrictions?.defaultValue || restrictions?.default) {

                    if (useDefault) useDefault.checked = true;

                    if (manualToggleContainer) manualToggleContainer.style.display = "";

                    if (restrictions.manual) {

                        if (manualToggle) manualToggle.checked = true;

                        if (manualValueContainer) manualValueContainer.style.display = "";
                        if (defaultQuestionContainer) defaultQuestionContainer.style.display = "none";

                        if (manualInput) manualInput.value = restrictions.default || "";

                    }
                    else {

                        if (manualToggle) manualToggle.checked = false;

                        if (manualValueContainer) manualValueContainer.style.display = "none";
                        if (defaultQuestionContainer) defaultQuestionContainer.style.display = "";

                        if (dropdown) dropdown.value = restrictions.defaultValue;

                    }

                }

            }

            /* READONLY */

            if (readonlyToggle && restrictions?.readonly) {
                readonlyToggle.checked = true;
            }

            /* ERROR MESSAGE */

            if (errorInput && restrictions?.message) {
                errorInput.value = restrictions.message;
            }
        }



        //Show hide behavior fields dynamilcally

        document.addEventListener("change", (e) => {

            const type = (window._currentRestrictionType || "").toUpperCase();

            const isSelect =
                type.includes("SELECT ONE") ||
                type.includes("SELECT MANY");

            const defaultToggle = document.getElementById("useDefault");
            const manualToggle = document.getElementById("isManual");

            const manualToggleContainer = document.getElementById("manualToggleContainer");
            const manualValueContainer = document.getElementById("manualValueContainer");
            const defaultQuestionContainer = document.getElementById("defaultQuestionContainer");

            if (e.target.id === "useDefault") {

                if (!defaultToggle.checked) {

                    if (manualToggleContainer) manualToggleContainer.style.display = "none";
                    if (manualValueContainer) manualValueContainer.style.display = "none";
                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "none";

                    return;
                }

                // DEFAULT ON

                if (isSelect) {

                    // SELECT ONE / MANY behaviour
                    if (manualToggleContainer) manualToggleContainer.style.display = "none";
                    if (manualValueContainer) manualValueContainer.style.display = "none";
                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "";

                } else {

                    // NUMERIC / TEXT behaviour
                    if (manualToggleContainer) manualToggleContainer.style.display = "";
                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "";
                    if (manualValueContainer) manualValueContainer.style.display = "none";

                }
            }

            if (e.target.id === "isManual") {

                if (!manualToggle) return;

                if (manualToggle.checked) {

                    if (manualValueContainer) manualValueContainer.style.display = "";
                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "none";

                } else {

                    if (manualValueContainer) manualValueContainer.style.display = "none";
                    if (defaultQuestionContainer) defaultQuestionContainer.style.display = "";
                }
            }

        });


        //Get lookup values

                async function loadLookupDefaultValues() {

            const lookupId = window._currentLookupId;

                const dropdown = document.getElementById("defaultValueSelect");

            if (!lookupId || !dropdown) return;

            try {

                const resp = await fetch(`?handler=LookupValues&lookupId=${lookupId}`);

                const data = await resp.json();

                dropdown.innerHTML = "";

                data.forEach(v => {

                    const opt = document.createElement("option");

                    opt.value = v.id;
                    opt.textContent = v.text;

                    dropdown.appendChild(opt);

                });

            }
            catch (err) {

                console.error("Failed loading lookup values", err);

            }

        }

                    function loadStaticDefaultValues(questionType) {

            const dropdown = document.getElementById("defaultValueSelect");
            if (!dropdown) return;

            dropdown.innerHTML = `<option value="" disabled selected>Select value</option>`;

            const type = (questionType || "").toUpperCase();

            defaultValueOptions
                .filter(v => (v.Types || []).some(t => type.includes(t)))
                .forEach(v => {

                    const opt = document.createElement("option");

                    opt.value = v.Key;
                    opt.textContent = v.Label;

                    dropdown.appendChild(opt);

                });
        }


                function showSuccessToast(message) {

            const toast = document.createElement("div");

            toast.className = "position-fixed top-0 end-0 m-3 alert alert-success shadow";

            toast.style.zIndex = "2000";

            toast.innerText = message;

            document.body.appendChild(toast);

            setTimeout(() => toast.remove(), 3000);

        }


    </script>

    <!-- expose numeric question list for calculated-field operand selects -->
    <script>
        // expose numeric question list for calculated-field operand selects (includes saved resultExpression)
        window.__numericQuestions = (Array.isArray(initialQuestions) ? initialQuestions : [])
          .map(q => ({
            questionId: q.SourceId || q.Id,
            label: q.QuestionText || q.Text || q.label || q.QuestionLabel || '',
            value: (q.CurrentValue !== undefined ? q.CurrentValue : (q.Value !== undefined ? q.Value : null)),
            // add saved ResultExpression (string or null) so client can pre-populate the modal
            resultExpression: (q.ResultExpression !== undefined && q.ResultExpression !== null) ? q.ResultExpression : (q.ResultExpression === null ? null : (q.ResultExpression || q.Expression || null))
          }));
    </script>


    <!-- calculated-field client script  -->
    <script src="~/js/calculated-field.js"></script>

}
