@* QUESTIONBUILDER.CSHTML *@

@page "{SurveyId:int}"
@model BRaVe_Portal.Pages.surveys.Questionnaire.QuestionBuilderModel
@using System.Text.Json
@using BRaVe_Portal.Models
@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models.DTOs

@{
    ViewData["Title"] = "Questionnaire Builder";

    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.QuestionTypes ?? new List<LookupItemDto>();
}

<div class="container py-4">

    <a asp-page="/Surveys/Index"
       
       class="btn btn-outline-primary d-inline-flex align-items-center">
        <i class="fa fa-arrow-left me-2"></i> Back
    </a>
    <br /><br />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Survey summary card  -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="row align-items-center g-3">

                <!-- Title and meta -->
                <div class="col">
                    <h5 class="mb-1 fw-bold text-truncate">
                        <span class="text-primary">
                            @Model.CurrentSurvey?.SurveyCode — @Model.CurrentSurvey?.Title
                        </span>
                    </h5>

                    <div class="d-flex flex-wrap gap-3 align-items-center small text-muted">
                        <div>
                            Active:
                            @if (Model.CurrentSurvey?.IsActive == true)
                            {
                                <span class="badge bg-success ms-1">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-1">No</span>
                            }
                        </div>

                        <div>
                            Last updated:
                            <span class="fw-semibold ms-1 text-dark">
                                @Model.CurrentSurvey?.UpdatedOn.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="col-auto text-end">

                   @*  <button class="btn btn-outline-primary btn-sm me-2" title="Validate survey">
                        <i class="fa fa-check me-1"></i> Validate
                    </button> *@

                    <form method="post" asp-page-handler="ActivateSurvey" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.CurrentSurvey?.SurveyId" />
                        <button type="submit"
                                class="btn btn-sm @(Model.CurrentSurvey?.IsActive == true ? "btn-outline-success" : "btn-success")"
                                title="Activate survey">
                            <i class="fa fa-bolt me-1"></i>
                            @(Model.CurrentSurvey?.IsActive == true ? "Activated" : "Activate")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CurrentSurvey?.IsActive == true)
    {
        <div class="alert alert-warning d-flex align-items-center shadow-sm">
            <i class="fa fa-lock me-2"></i>
            <div>
                <strong>Survey is active.</strong> Editing is locked.
                You cannot add or modify questions in an active survey. Deactivate to proceed.
            </div>
        </div>
    }

    <div class="card shadow-sm @(Model.CurrentSurvey?.IsActive == true ? "readonly-mode" : "")">
        <div class="card-header d-flex justify-content-between align-items-center bg-white">
            <h5 class="mb-0">Questionnaire Builder</h5>
            <div class="d-flex gap-2">
                <button id="addQuestionBtn"
                        class="btn btn-sm btn-outline-primary"
                        @(Model.CurrentSurvey?.IsActive == true ? "disabled title='Survey is active. Editing locked'" : "")>
                    Add Question
                </button>

                <button id="saveAllBtn"
                        class="btn btn-sm btn-primary"
                        onclick="showLoader()"
                        @(Model.CurrentSurvey?.IsActive == true ? "disabled title='Survey is active. Editing locked'" : "")>
                    Save All
                </button>
            </div>
        </div>

        <div class="card-body p-3">
            <div id="questionList" class="d-flex flex-column gap-3">
                @* question cards injected by JS *@
            </div>
        </div>

        <div class="card-footer bg-light text-muted small">
            Drag cards to reorder
        </div>
    </div>

</div>

<form id="deleteForm" method="post" asp-page-handler="DeleteQuestion">
    @Html.AntiForgeryToken()
    <input type="hidden" name="QuestionId" />
    <input type="hidden" name="surveyCode" value="@Model.CurrentSurvey?.SurveyCode" />
    <input type="hidden" name="surveyId" value="@Model.SurveyId" />
</form>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow">

            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title">Confirm Delete</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete this question?</p>
            </div>

            <div class="modal-footer py-2">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmDeleteBtn" class="btn btn-danger btn-sm">Delete</button>
            </div>

        </div>
    </div>
</div>

@* Anti-forgery token so JS can read it when POSTing *@
<form id="antiforgeryForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@await Html.PartialAsync("_RestrictionsModal")

@await Html.PartialAsync("_CalculatedFieldModal")


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
         //Default dropdown valus for restriction modal
            const defaultValueOptions = @Html.Raw(JsonSerializer.Serialize(Model.DefaultValueOptions));
        // --- server-provided data ---
        const initialQuestions = @Html.Raw(JsonSerializer.Serialize(Model.Questions));

                // ---- hydrate admin level from Restriction JSON ----
        (initialQuestions || []).forEach(q => {

            if (!q.Restriction) return;

            try {
                const r = typeof q.Restriction === "string"
                    ? JSON.parse(q.Restriction)
                    : q.Restriction;

                if (r?.type === "administrative_level" && r?.value?.id) {

                    // make UI understand selected value
                    q.LookupId = r.value.id;

                    // also keep object version for preview/modal usage
                    q.Restrictions = r;
                }
            }
            catch (e) {
                console.warn("Failed parsing restriction JSON", e);
            }
        });
        const lookupTypes = @Html.Raw(JsonSerializer.Serialize(lookups));
        const lookupNames = @Html.Raw(JsonSerializer.Serialize(ViewData["LookupNames"] ?? Model.LookupNames ?? new List<BRaVe_Management_Backend.DTOs.LookupTableNameDto>()));
        const surveyId = @Model.SurveyId;
                const datasets = @Html.Raw(JsonSerializer.Serialize(
                    ViewData["Datasets"] ?? new List<DatasetsDto>()
            ));

                const adminLevels = @Html.Raw(JsonSerializer.Serialize(
                ViewData["AdministrativeLevels"] ?? new List<AdministrativeLevel>()
        ));


        // --- normalize question types to stable shape { id, code, text } ---
        const normalizedLookupTypes = (Array.isArray(lookupTypes) ? lookupTypes : []).map(l => {
            const code = String(l.Id);
            return {
                id: l?.Id ?? null,
                code: code,
                text: l?.Text ?? l?.text ?? String(l)
            };
        });



        // --- normalize lookup *sources* to stable shape { id, name } ---
        const normalizedLookupSources = (Array.isArray(lookupNames) ? lookupNames : []).map(l => {
            return {
                id: l?.Id ?? null,
                name: l?.LookupName ?? l?.lookupName ?? String(l)
            };
        });

        //    // --- normalize datasets

                const normalizedDatasets = (Array.isArray(datasets) ? datasets : []).map(d => ({
            id: d?.Id ?? null,
            name: d?.Title ?? d?.title ?? String(d)
        }));

             // --- normalize admin levels
                const normalizedAdminLevels = (Array.isArray(adminLevels)
            ? adminLevels
            : []).map(a => ({
                id: a?.Id ?? null,
                name: a?.LevelName ?? ''
        }));

            const DATASET_TYPE_IDS = normalizedLookupTypes
        .filter(t => (t.text || '').toUpperCase() === 'DATASET')
        .map(t => String(t.code));



        console.log('lookupTypes (normalized):', normalizedLookupTypes);
        console.log('lookupSources (normalized):', normalizedLookupSources);

        /* --- Minimal restrictions helpers (global state) --- */
        if (typeof window.currentRestrictions === 'undefined') window.currentRestrictions = {};
        if (typeof window.currentQuestionId === 'undefined') window.currentQuestionId = null;
        if (typeof window._restrictionsEditingQid === 'undefined') window._restrictionsEditingQid = null;

        /* ---------- renderTypeSpecificFields (keeps existing semantics, safe to overwrite) ---------- */
        if (typeof renderTypeSpecificFields !== 'function') {
          function renderTypeSpecificFields(type) {
            const container = document.getElementById('typeSpecificContainer');
            if (!container) return;
            const t = (type || '').toString().toUpperCase();

            let html = '<h6 class="card-title text-uppercase text-muted small fw-bold mb-3">Type Constraints</h6>';

            if (t.includes('INT') || t.includes('NUM') || t.includes('NUMBER')) {
              html += `
                <div class="row g-3 mb-3">
                  <div class="col-6"><label class="form-label">Minimum</label><input type="number" class="form-control" name="min" /></div>
                  <div class="col-6"><label class="form-label">Maximum</label><input type="number" class="form-control" name="max" /></div>
                </div>
                <div class="mb-3"><label class="form-label">Step size (optional)</label><input type="number" class="form-control" name="step" step="any" /></div>
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="allowNeg" name="allowNegative"><label class="form-check-label" for="allowNeg">Allow negative numbers</label></div>
              `;
              const p = document.getElementById('previewInput'); if (p) { p.type = 'number'; p.disabled = false; p.placeholder = ''; }
            }
            else if (t.includes('TEXT') || t.includes('NOTE')) {
              html += `
                <div class="row g-3 mb-3">
                  <div class="col-6"><label class="form-label">Min length</label><input type="number" class="form-control" name="minLength" /></div>
                  <div class="col-6"><label class="form-label">Max length</label><input type="number" class="form-control" name="maxLength" /></div>
                </div>
                <div class="mb-3"><label class="form-label">Regex pattern (optional)</label><input type="text" class="form-control font-monospace" name="pattern" placeholder="^[A-Za-z]+$" /></div>
              `;
              const p = document.getElementById('previewInput'); if (p) { p.type = 'text'; p.disabled = false; p.placeholder = ''; }
            }
            else if (t.includes('DATE')) {
              html += `
                <div class="row g-3 mb-3">
                  <div class="col-6"><label class="form-label">Earliest date</label><input type="date" class="form-control" name="minDate" /></div>
                  <div class="col-6"><label class="form-label">Latest date</label><input type="date" class="form-control" name="maxDate" /></div>
                </div>
                <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="noFuture" id="noFuture"><label class="form-check-label" for="noFuture">Prevent future dates</label></div>
                <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="noPast" id="noPast"><label class="form-check-label" for="noPast">Prevent past dates</label></div>
              `;
              const p = document.getElementById('previewInput'); if (p) { p.type = 'date'; p.disabled = false; p.placeholder = ''; }
            }
            else if (t.includes('GPS') || t.includes('GPS_COORDINATES')) {
              html += `
                <div class="row g-3 mb-3">
                  <div class="col-6"><label class="form-label">Min lat</label><input type="number" class="form-control" name="minLat" step="any"></div>
                  <div class="col-6"><label class="form-label">Max lat</label><input type="number" class="form-control" name="maxLat" step="any"></div>
                  <div class="col-6"><label class="form-label">Min lng</label><input type="number" class="form-control" name="minLng" step="any"></div>
                  <div class="col-6"><label class="form-label">Max lng</label><input type="number" class="form-control" name="maxLng" step="any"></div>
                </div>
                <hr/>
                <div class="mb-3">
                  <label class="form-label small fw-bold">Geofence (lat,lng,m)</label>
                  <div class="input-group mb-2"><input type="number" class="form-control" name="radiusLat" step="any" placeholder="lat"><input type="number" class="form-control" name="radiusLng" step="any" placeholder="lng"></div>
                  <div class="input-group"><span class="input-group-text">Meters</span><input type="number" class="form-control" name="radiusMeters"></div>
                </div>
              `;
              const p = document.getElementById('previewInput'); if (p) { p.type = 'text'; p.disabled = true; p.placeholder = 'GPS preview not supported'; }
            }
                    else if (t.includes('DATASET')) {
          html += `
            <div class="row g-3 mb-3">
              <div class="col-6">
                <label class="form-label">Minimum Value</label>
                <input type="number" class="form-control" name="min" />
              </div>
              <div class="col-6">
                <label class="form-label">Maximum Value</label>
                <input type="number" class="form-control" name="max" />
              </div>
            </div>

            <div class="alert alert-info small">
              <i class="bi bi-info-circle me-2"></i>
              Applies validation on dataset-derived value
            </div>
          `;

          const p = document.getElementById('previewInput');
          if (p) {
            p.type = 'number';
            p.disabled = false;
            p.placeholder = 'Enter dataset value...';
          }
        }
            else {

                        html += `
          <div class="alert alert-light border text-muted small mb-0">
              <i class="bi bi-info-circle me-2"></i>
                  No specific constraints for this question type
          </div>
        `;
            
              const p = document.getElementById('previewInput'); if (p) { p.type = 'text'; p.disabled = false; p.placeholder = ''; }
            }

            container.innerHTML = html;
          }
        }



        /* ---------- populateForm (keeps existing semantics) ---------- */
        if (typeof populateForm !== 'function') {
          function populateForm(data) {
            const form = document.getElementById('restrictionsForm');
            if (!form) return;
            form.reset();
            if (!data || typeof data !== 'object') return;
            for (const [k, v] of Object.entries(data)) {
              try {
                const el = form.elements[k];
                if (!el) {
                  if (k === 'withinRadius' && Array.isArray(v)) {
                    if (form.elements['radiusLat']) form.elements['radiusLat'].value = v[0] ?? '';
                    if (form.elements['radiusLng']) form.elements['radiusLng'].value = v[1] ?? '';
                    if (form.elements['radiusMeters']) form.elements['radiusMeters'].value = v[2] ?? '';
                  }
                  continue;
                }
                if (el.type === 'checkbox') el.checked = !!v;
                else el.value = v ?? '';
              } catch (e) { /* ignore */ }
            }
          }
        }

        /* ---------- Modal helpers: update state, JSON, active list, preview, save ---------- */

        function updateStateFromForm() {

            const form = document.getElementById('restrictionsForm');
            if (!form) return;

            const obj = {};

            for (const el of Array.from(form.elements)) {

                if (!el.name) continue;

                if (el.type === 'checkbox') {
                    obj[el.name] = el.checked;
                }
                else if (el.type === 'number') {
                    obj[el.name] = el.value === '' ? undefined : Number(el.value);
                }
                else {
                    obj[el.name] = el.value === '' ? undefined : el.value;
                }
            }

          

            /* DEFAULT VALUE LOGIC */

            const useDefault = document.getElementById("useDefault")?.checked;
            const manual = document.getElementById("isManual")?.checked;

            if (useDefault) {

                if (manual) {
                    obj.default = document.getElementById("defaultValue")?.value || null;
                    obj.manual = true;
                }
                else {
                    obj.defaultValue = document.getElementById("defaultValueSelect")?.value || null;
                    obj.manual = false;
                }

            }

                    const readonly = document.getElementById("readonlyToggle")?.checked;
        if (readonly) obj.readonly = true;

        const message = document.getElementById("errorMessage")?.value;
        if (message) obj.message = message;


            /* CLEANUP */

            Object.keys(obj).forEach(k => {
                if (obj[k] === undefined || obj[k] === '') delete obj[k];
            });

            window.currentRestrictions = obj;
        }

        function renderJsonOutput() {
          const pre = document.getElementById('jsonOutput');
          if (!pre) return;
          pre.textContent = JSON.stringify(window.currentRestrictions || {}, null, 2);
        }

        function renderActiveConstraints() {
          const ul = document.getElementById('activeConstraintsList');
          if (!ul) return;
          const rules = window.currentRestrictions || {};
          const ignore = ['message'];
          const keys = Object.keys(rules).filter(k => !ignore.includes(k));
          if (!keys.length) {
            ul.innerHTML = '<li class="list-group-item bg-transparent text-muted small fst-italic text-center py-3">No active rules</li>';
            return;
          }
          ul.innerHTML = keys.map(k => {
            const v = rules[k];
            const display = Array.isArray(v) ? `[${v.join(', ')}]` : String(v);
            return `<li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                      <span class="font-monospace small text-muted">${k}</span>
                      <span class="fw-medium small">${display}</span>
                    </li>`;
          }).join('');
        }

        function showFeedback(isValid, message) {
          const feedbackEl = document.getElementById('validationFeedback');
          if (!feedbackEl) return;
          if (isValid) {
            feedbackEl.innerHTML = `<i class="bi bi-check-circle-fill text-success me-2"></i><span class="text-success">${message}</span>`;
          } else {
            feedbackEl.innerHTML = `<i class="bi bi-exclamation-circle-fill text-danger me-2"></i><span class="text-danger">${message}</span>`;
          }
        }

        function validatePreview() {
          const input = document.getElementById('previewInput');
          if (!input) return;
          const val = input.value;
          const rules = window.currentRestrictions || {};
          const typeBadge = document.getElementById('modalQuestionType');
          const type = (typeBadge && typeBadge.textContent) ? typeBadge.textContent.toUpperCase() : '';

          if (!val) {
            showFeedback(true, 'No value (ok)');
            return;
          }

          try {
            if (type.includes('INT') || type.includes('NUM')) {
              const num = Number(val);
              if (isNaN(num)) throw 'Not a valid number';
              if (rules.min !== undefined && num < rules.min) throw `Must be ≥ ${rules.min}`;
              if (rules.max !== undefined && num > rules.max) throw `Must be ≤ ${rules.max}`;
              if (rules.allowNegative === false && num < 0) throw 'Negative numbers not allowed';
            }

            if (type.includes('TEXT') || type.includes('NOTE')) {
              if (rules.minLength !== undefined && val.length < rules.minLength) throw `Too short (min ${rules.minLength})`;
              if (rules.maxLength !== undefined && val.length > rules.maxLength) throw `Too long (max ${rules.maxLength})`;
              if (rules.pattern) {
                const re = new RegExp(rules.pattern);
                if (!re.test(val)) throw 'Format does not match pattern';
              }
            }

            if (type.includes('DATE')) {
              const d = new Date(val);
              if (isNaN(d.getTime())) throw 'Invalid date';
              if (rules.minDate && new Date(rules.minDate) > d) throw `Must be after ${rules.minDate}`;
              if (rules.maxDate && new Date(rules.maxDate) < d) throw `Must be before ${rules.maxDate}`;
              const today = new Date(); today.setHours(0,0,0,0);
              if (rules.noFuture && d > today) throw 'Future date not allowed';
              if (rules.noPast && d < today) throw 'Past date not allowed';
            }
            if (type.includes('DATASET')) {
            const num = Number(val);
            if (isNaN(num)) throw 'Not a valid number';

            if (rules.min !== undefined && num < rules.min)
                throw `Must be ≥ ${rules.min}`;

            if (rules.max !== undefined && num > rules.max)
                throw `Must be ≤ ${rules.max}`;
        }

            showFeedback(true, 'Valid input');
          } catch (err) {
            showFeedback(false, (typeof window.currentRestrictions?.message === 'string' && window.currentRestrictions.message.length) ? window.currentRestrictions.message : String(err));
          }
        }

        /* Bind small form listeners for immediate feedback and Save button */
        (function bindModalFormListeners() {
          document.addEventListener('input', (e) => {
            const modal = document.getElementById('restrictionsModal');
            if (!modal) return;
            if (!e.target || !e.target.form || e.target.form.id !== 'restrictionsForm') return;
            updateStateFromForm();
            renderJsonOutput();
            renderActiveConstraints();
            validatePreview();
          });

          document.addEventListener('input', (e) => {
            if (e.target && e.target.id === 'previewInput') validatePreview();
          });
        })();

        // helper: escape HTML when injecting values into templates
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        (function () {
            let questions = Array.isArray(initialQuestions) && initialQuestions.length
                ? initialQuestions
                : [{
                    Id: 'id-' + Math.random().toString(36).slice(2, 9),
                    SourceId: null,
                    QuestionOrder: null,
                    Text: '',
                    Type: normalizedLookupTypes[0]?.code || "1",
                    LookupId: null,
                    DatasetId: null,
                    MinSelection: null,
                    MaxSelection: null,
                    Required: false,
                    Active: true,
                    Expression: ''
                }];

            const listEl = document.getElementById('questionList');
            const addBtn = document.getElementById('addQuestionBtn');
            const saveBtn = document.getElementById('saveAllBtn');
            let pendingDelete = null; // holds the model to delete
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

            // --- SINGLE, CLEAN SAVE BUTTON HANDLER FOR RESTRICTIONS MODAL ---
            document.addEventListener('click', async (e) => {
                const btn = e.target.closest && e.target.closest('#btnSave');
                if (!btn) return; // ignore all other clicks

                e.preventDefault();
                showLoader(); 

                // Pull latest values from the form into window.currentRestrictions
                updateStateFromForm();

                const editQid = window._restrictionsEditingQid;

                // Find the question being edited
                const target = (editQid !== undefined && editQid !== null)
                    ? questions.find(q =>
                        Number(q.SourceId) === Number(editQid) ||
                        String(q.Id) === String(editQid))
                    : null;

                // Update in-memory question model
                if (target) {
                    target.Restrictions = { ...(window.currentRestrictions || {}) };
                }

                const questionId = target ? Number(target.SourceId) : NaN;

                // If this question already exists in DB -> save to server
                if (!isNaN(questionId) && questionId > 0) {
                        const token = document.querySelector('#antiforgeryForm input[name="_bravePortalCsrf"]')
                        ?.value;

                    try {
                        const resp = await fetch(
                            `?handler=SaveRestrictions&questionId=${encodeURIComponent(questionId)}&surveyId=${encodeURIComponent(surveyId)}`,
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                        ...(token ? { 'X-BRaVe-Portal-CSRF': token } : {})
                                },
                                body: JSON.stringify(window.currentRestrictions || {})
                            }
                        );

                        const json = await resp.json();

           if (json && json.success === true) {

            if (typeof renderAll === 'function') renderAll();

            bootstrap.Modal.getOrCreateInstance(
                document.getElementById('restrictionsModal')
            ).hide();

            showSuccessToast("Restrictions saved successfully");

        }

                        else {
                            console.warn("Saving restrictions failed:", json);
                        }
                    } catch (err) {
                        console.error("Failed to POST restrictions:", err);
                    }
                }

                // If question is NOT yet saved (no SourceId), just update UI and close modal
                if (typeof renderAll === 'function') renderAll();

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('restrictionsModal')
                ).hide();
            });

            // helpers to detect select types
            function isSelectOneTypeCode(typeCode) {
                if (!typeCode) return false;
                const item = normalizedLookupTypes.find(l => String(l.code) === String(typeCode));
                if (!item) return false;
                const txt = (item.text || '').toLowerCase();
                return txt.includes('select one') || txt.includes('single select') || txt.includes('single-choice');
            }

                    function isAdministrativeLevelTypeCode(typeCode) {
            if (!typeCode) return false;

            const item = normalizedLookupTypes.find(l =>
                String(l.code) === String(typeCode)
            );

            if (!item) return false;

            const txt = (item.text || '').toLowerCase();

