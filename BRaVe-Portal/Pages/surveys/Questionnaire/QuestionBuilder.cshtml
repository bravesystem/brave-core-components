            // --- Drag & drop ordering ---
            let dragged = null;
            function rebindDraggables() {
                const cards = document.querySelectorAll('.qb-card');
                cards.forEach(card => {
                    card.ondragstart = dragStart;
                    card.ondragover = dragOver;
                    card.ondrop = drop;
                    card.ondragend = dragEnd;
                });
            }

            function dragStart(e) {
                dragged = e.currentTarget;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', dragged.dataset.id);
                dragged.classList.add('dragging');
            }

            function dragOver(e) {
                e.preventDefault();
                const target = e.currentTarget;
                if (target && target !== dragged) {
                    const rect = target.getBoundingClientRect();
                    const next = (e.clientY - rect.top) / rect.height > 0.5;
                    target.parentNode.insertBefore(dragged, next ? target.nextSibling : target);
                }
            }

            function drop(e) {
                e.preventDefault();
            }

            function dragEnd(e) {
                if (dragged) dragged.classList.remove('dragging');
                const ids = Array.from(document.querySelectorAll('.qb-card')).map(c => c.dataset.id);
                questions = ids.map(id => questions.find(q => q.Id === id));
