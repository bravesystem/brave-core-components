@page
@model BRaVe_Portal.Pages.surveys.IndexModel
@using BRaVe_Portal.Models
@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models.DTOs
@{
    ViewData["Title"] = "Surveys";
    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.SurveyTypes ?? new List<LookupItemDto>();
}
<form method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label for="programSelect" class="form-label fw-semibold">Select Program</label>
            <select id="programSelect"
                    name="SelectedProgramId"
                    class="form-select shadow-sm rounded-pill border-0 px-3 py-2 modern-select"
                    onchange="this.form.submit()">
                <option value="0" selected="@(Model.SelectedProgramId == null || Model.SelectedProgramId == 0)">
                    All Programs
                </option>
                @foreach (var program in Model.Programs)
                {
                    <option value="@program.ProgramId" selected="@(program.ProgramId == Model.SelectedProgramId)">
                        @program.Title
                    </option>
                }
            </select>
        </div>

        @if (Model.SelectedProgramId.HasValue && Model.SelectedProgramId > 0)
        {
         

            <div class="col-md-8 text-end">
              

                <button type="button"
                        class="btn btn-success create-survey-btn shadow-sm rounded-pill px-4"
                        data-bs-toggle="modal"
                        data-bs-target="#addSurveyModal">
                    <i class="fa fa-plus me-2"></i> Create New Survey
                </button>
            </div>
        }
    </div>
</form>




@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div asp-validation-summary="All" class="alert alert-danger"></div>

@if ((Model.Surveys?.Count ?? 0) > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">Surveys</div>
        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Program</th>
                        <th>Survey Code</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Questions</th>
                        <th>Last Modified</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var survey in Model.Surveys.OrderByDescending(s => s.CreatedOn))
                    {
                        <tr>
                            <td>@survey.ProgramName</td>
                            <td>@survey.SurveyCode</td>
                            <td>@survey.Title</td>
                            <td>@survey.Details</td>
                            <td>

                                @LookupHelper.GetTextById(lookups,@survey.SurveyType)
                                
                            </td>
                            <td>
                                <a asp-page="/surveys/Questionnaire/QuestionBuilder" asp-route-SurveyId="@survey.SurveyId"
                                   class="btn btn-sm btn-primary shadow-sm">

                                    ( @survey.TotalQuestions )

                                    <i class="fa fa-tools"></i>
                                </a>
                            </td>
                            <td>@survey.UpdatedOn.ToString("yyyy-MM-dd")</td>
                            <td>

                                @if (!@survey.IsActive.HasValue || !survey.IsActive.Value)
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-times"></i>
                                    </span>
                                    
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check"></i>
                                    </span>
                                }

                            </td>
                            <td>
                                @*  //Button for new questionnaire format *@
                                


                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editSurveyModal"
                                        data-id="@survey.SurveyId"
                                        data-title="@survey.Title"
                                        data-description="@survey.Details"
                                        data-type="@survey.SurveyType"
                                        data-programid="@survey.ProgramId"
                                        data-active="@(survey.IsActive)">
                                    <i class="fa fa-edit"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#DeletSurveyModal"
                                        data-id="@survey.SurveyId"
                                        data-programid="@survey.ProgramId"
                                        data-title="@survey.ToString()">
                                    <i class="fa fa-trash"></i>
                                </button>

                               
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning text-center mt-5 p-4 rounded shadow-sm">
        <h4 class="alert-heading">No Surveys Found</h4>
    </div>
}

<partial name="_AddSurveyModal" model="new SurveyDto { ProgramId = Model.SelectedProgramId ?? 0 }" />
<partial name="_EditSurveyModal" model="Model.UpdatedSurvey" />
<partial name="_DeleteSurveyModal" model="Model.UpdatedSurvey" />

@section Scripts {
    <script>
        const editModal = document.getElementById('editSurveyModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            document.getElementById('editSurveyId').value = button.getAttribute('data-id');
            document.getElementById('editSurveyProgram').value = button.getAttribute('data-programid');
            document.getElementById('editSurveyTitle').value = button.getAttribute('data-title');
            document.getElementById('editSurveyDetails').value = button.getAttribute('data-description');
            document.getElementById('editSurveyType').value = button.getAttribute('data-type');
            document.getElementById('editSurveyActive').checked = button.getAttribute('data-active') === "True";
        });
        
        const deleteModal = document.getElementById('DeletSurveyModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const surveyId = button.getAttribute('data-id');
            const surveyTitle = button.getAttribute('data-title');

            document.getElementById('deleteSurveyId').value = surveyId;
            document.getElementById('deleteSurveyTitle').textContent = surveyTitle;
            document.getElementById('deleteSurveyProgram').value = button.getAttribute('data-programid');
        
        });
    </script>

}
