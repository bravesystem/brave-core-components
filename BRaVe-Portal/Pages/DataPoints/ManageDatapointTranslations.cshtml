@page "{DataPointId:int}/{CategoryId:int}"
@model BRaVe_Portal.Pages.DataPoints.ManageDatapointTranslationsModel


@{
    ViewData["Title"] = "Manage Translations";
}

<a asp-page="/DataPoints/Index" class="btn btn-outline-primary d-inline-flex align-items-center">
    <i class="fa fa-arrow-left me-2"></i> Back
</a>
<br />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">Datapoint: @Model.DataPointId - Category: @Model.CategoryId</h4><br />

            <p class="text-muted small mb-0">
              
                Default Language: <span class="badge bg-primary">@Model.DefaultLang</span> <br />
            </p>
        </div>
    </div> 

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
            <span>Translations</span>
            <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#addTranslationModal">
                <i class="fa fa-plus"></i> Add Translation
            </button>
        </div>

        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Default</th>
                        <th>Language</th>
                        <th>Text</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Translations)
                    {
                        <tr>
                            <td class="text-center">
                                <input class="form-check-input"
                                       type="checkbox"
                                       disabled
                                       @(t.LanguageCode == Model.DefaultLang ? "checked" : "") />
                            </td>
                            <td>@t.LanguageCode</td>
                            <td>@t.Text</td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTranslationModal"
                                            data-id="@Model.DataPointId"
                                            data-language="@t.LanguageCode"
                                            data-text="@t.Text"
                                            title="Edit this translation">
                                        <i class="fa fa-edit"></i>
                                    </button>

                                    @if (t.LanguageCode != Model.DefaultLang)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteTranslationModal"
                                                data-language="@t.LanguageCode"
                                                title="Delete this translation">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div><br />
</div>

<!-- Modals -->

<!--Add modal-->
<!-- Add Translation Modal -->
<div class="modal fade" id="addTranslationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Translation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AddTranslation">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="NewTranslation.Id" value="@Model.DataPointId" />
                   
                    <div class="mb-3">
                        <label class="form-label">Language Code</label>
                        <select class="form-select" asp-for="NewTranslation.LanguageCode" required>
                            <option value="En">en</option>
                            <option value="Fr">fr</option>
                            <option value="Es">es</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Text</label>
                        <input asp-for="NewTranslation.Text" class="form-control" required />
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Translation Modal -->
<div class="modal fade" id="editTranslationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Translation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="EditTranslation">

                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EditTranslation.Id" value="@Model.DataPointId" />
                   

                    <div class="mb-3">
                        <label class="form-label">Language Code</label>
                        <input asp-for="EditTranslation.LanguageCode" id="editLanguageCode" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Text</label>
                        <input asp-for="EditTranslation.Text" id="editText" class="form-control" required />
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Translation Modal -->
<div class="modal fade" id="deleteTranslationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-3 border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fa fa-exclamation-triangle me-2"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <strong>Are you sure you want to delete this translation?</strong>
                <div class="mt-2">
                </div>
            </div>

            <div class="modal-footer">
                <form method="post" asp-page-handler="DeleteTranslation">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="languageCode" id="deleteLanguageCode" />
                    <input type="hidden" name="SurveyCode" value="@Model.DataPointId" />
                    <input type="hidden" name="QuestionId" value="@Model.CategoryId" />

                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-trash"></i> Yes, Delete
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Populate Edit modal
        const editModal = document.getElementById('editTranslationModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const language = button.getAttribute('data-language');
            const text = button.getAttribute('data-text');

            document.getElementById('editLanguageCode').value = language;
            document.getElementById('editText').value = text;
        });


        // Handle Delete modal
        const deleteModal = document.getElementById('deleteTranslationModal');
        deleteModal?.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const language = button.getAttribute('data-language');

            document.getElementById('deleteLanguageCode').value = language;
            document.getElementById('deleteLanguageDisplay').textContent = language;
        });
    </script>
}


