<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Deduplication Jobs</h2>

    <div class="d-flex gap-2">
        <!-- Refresh Button -->
        <a asp-page="/DuplicateRulesets/DeduplicationJobs"
           class="btn btn-outline-primary"
           title="Refresh">
            <i class="fa fa-refresh"></i> Refresh
        </a>

        <!-- Add Button -->
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addJobModal">
            <i class="fa fa-plus"></i> Create Deduplication Job
        </button>
    </div>
</div>

<!-- Add Job Modal -->
<div class="modal fade" id="addJobModal" tabindex="-1" aria-labelledby="addJobModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addJobModalLabel">Create Deduplication Job</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Add">

                @Html.AntiForgeryToken()

                <div class="modal-body">
                    @* <input type="hidden" name="tenantId" value="@Model?.TenantId" /> *@
                    <div class="mb-3">
                        <label for="ruleId" class="form-label">Rule</label>
                        <select id="ruleId" name="ruleId" class="form-select" required>
                            <option value="">— Select a rule —</option>
                            @if (Model.RuleItems != null)
                            {
                                @foreach (var item in Model.RuleItems)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="startPeriod" class="form-label">Start Date</label>
                        <input type="date" id="startPeriod" name="startPeriod" class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label for="endPeriod" class="form-label">End Date</label>
                        <input type="date" id="endPeriod" name="endPeriod" class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Create Job
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Job Id</th>
            <th>Ruleset Name</th>
            <th>Status</th>
            <th>Created On</th>
            <th>Completed On</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in jobs.OrderBy(j=>j.Order).ThenByDescending(j=>j.CreatedOn))
        {
            <tr>
                <td>Job-@job.JobId</td>
                <td>@job.RulesetName</td>
                <td>
                    <span class="badge @GetStatusBadgeClass(job.StatusId)">@job.StatusName</span>
                </td>
                <td>@job.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@(job.CompletedOn?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                <td>
                    @if (job.StatusId == JobStatus.Completed)
                    {
                        <a asp-page="/DuplicateRulesets/DeduplicationResults" asp-route-jobId="@job.JobId" class="btn btn-sm btn-outline-secondary me-1" title="View result">
                            <i class="fa fa-list-alt"></i> View result
                        </a>
                        <form method="post" asp-page-handler="ClearJob" asp-route-jobId="@job.JobId" class="d-inline" onsubmit="return confirm('Clear / disable this job?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Clear / Disable">
                                <i class="fa fa-ban"></i> Clear
                            </button>
                        </form>
                    }
                    else    
                    {
                        <span>—</span>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

@if (!jobs.Any())
{
    <p class="text-muted">No deduplication jobs. Use <strong>Add</strong> to create one.</p>
}

@functions {
    private static string GetStatusBadgeClass(int statusId)
    {
        return statusId switch
        {
            0 => "bg-secondary",   // Pending / Unknown
            1 => "bg-info",        // Running / Queued
            2 => "bg-success",      // Completed
            3 => "bg-danger",      // Failed / Cancelled
            4 => "bg-warning",     // Cancelled / Disabled
            _ => "bg-secondary"
        };
    }
}
