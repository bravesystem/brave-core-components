@page
@model BRaVe_Portal.Pages.DuplicateRulesets.DeduplicationJobsModel
@using System.Linq
@using BRaVe_Portal.Models.Enums
@{
    ViewData["Title"] = "Deduplication Jobs";
    var jobs = Model.Jobs;
}

