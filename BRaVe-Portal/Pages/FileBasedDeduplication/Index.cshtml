@page
@model BRaVe_Portal.Pages.FileBasedDeduplication.IndexModel
@{
    ViewData["Title"] = "File-Based Deduplication";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">File-Based Deduplication</h1>
        <p class="text-muted mb-0">Upload a JSON file and review the 10 most recent uploads.</p>
    </div>

    <form method="post"
          enctype="multipart/form-data"
          asp-page-handler="Upload"
          id="uploadForm"
          class="m-0">
        <input asp-for="Upload"
               type="file"
               id="fileInput"
               class="d-none"
               accept=".json,application/json"
               onchange="if (validateJsonUpload(this)) this.form.submit()" />
        <button type="button"
                class="btn btn-primary"
                onclick="document.getElementById('fileInput').click()">
            <i class="fa-solid fa-upload me-2"></i>Upload New File
        </button>
    </form>
</div>

@if (TempData["UploadSuccess"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["UploadError"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-header card-header-custom">
        <h5 class="mb-0">Recent Uploads</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentUploads.Count == 0)
        {
            <p class="text-muted mb-0 p-3">No files have been uploaded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Job ID</th>
                            <th>Filename</th>
                            <th>Uploaded By</th>
                            <th>Uploaded On</th>
                            <th>Status</th>
                            <th>Processed On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var upload in Model.RecentUploads)
                        {
                            <tr>
                                <td><code>@upload.JobId</code></td>
                                <td>@upload.Filename</td>
                                <td>@upload.UploadedBy</td>
                                <td>@upload.UploadedOn.ToString("g") UTC</td>
                                <td>
                                    @if (upload.IsProcessed)
                                    {
                                        <span class="badge text-bg-success">Processed</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Pending</span>
                                    }
                            </td>
                            <td>
                                @(upload.ProcessedOn?.ToString("g") is string processedOn
                                                            ? $"{processedOn} UTC"
                                                            : "—")
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    function validateJsonUpload(input) {
        const file = input.files?.[0];
        if (!file) {
            return false;
        }

        if (!file.name.toLowerCase().endsWith('.json')) {
            alert('Only .json files are allowed.');
            input.value = '';
            return false;
        }

        return true;
    }
</script>
