
@using BRaVe_Portal.Models
@model List<MissionPreferences>

@{
    var allPreferences = Model ?? (ViewData["AllPreferences"] as List<MissionPreferences>) ?? new List<MissionPreferences>();
    var selectedProgramId = ViewData["SelectedProgramId"] ?? 0;
}

<div class="modal fade" id="editMissionPreferenceModal" tabindex="-1" aria-labelledby="editMissionPreferenceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditMissionPreferences">
                @Html.AntiForgeryToken()

                <!-- Hidden fields for required binding -->
                <input type="hidden" name="UpdatedPreferences.ProgramId" value="@selectedProgramId" />
                <input type="hidden" name="UpdatedPreferences.Description" value="Batch Edit" />

                <div class="modal-header">
                    <h5 class="modal-title" id="addPreferenceModalLabel">Edit Preferences</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @if (!allPreferences.Any())
                    {
                        <div class="alert alert-warning mb-0">No Mission preferences available.</div>
                    }
                    else
                    {
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;">Select</th>

                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Default Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pref in allPreferences)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="SelectedPreferenceIds"
                                                   value="@pref.PreferenceId"
                                                   class="form-check-input" />
                                        </td>
                                        <td>@pref.PreferenceName</td>
                                        <td>@pref.PreferenceType</td>
                                        <td>
                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   name="PreferenceValues[@pref.PreferenceId]"
                                                   value="@pref.DefaultValue" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-save me-2"></i> Edit Selected
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
