@page
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Pages.Targeting.Criterias.CriteriaBuilderModel

@{
    var isEdit = Model.Criteria?.Id > 0;
    var surveys = Model.Surveys ?? new List<Survey>();
}

<style>
    textarea.auto-resize {
        overflow-y: hidden;
        resize: none;
        min-height: 120px;
    }
</style>

<form method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Criteria.Id" />
    <input type="hidden" asp-for="ProgramId" />
    <input type="hidden" asp-for="Criteria.TargetingId" />
    <input type="hidden" asp-for="IsValidated" />
    <input type="hidden" asp-for="TargetingId" />
    <input type="hidden" asp-for="TotalWeight" />
    <input type="hidden" asp-for="WeightBound" />
    <input type="hidden" asp-for="TotalCriteriaWeight" />
    <input type="hidden" asp-for="RuleName" />




    <!-- Persist JSON + Expression -->

    <div class="container-fluid">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>

                <div class="text-muted small">
                    <h4 class="fw-bold mb-0">
                        @(isEdit ? "Edit Criteria" : "Create Criteria")
                    </h4>

                    @if (isEdit)
                    {
                        <div class="text-muted small">
                            @Model.Criteria.CriteriaName
                        </div>
                    }

                </div>
            </div>


            @if (Model.WeightBound)
            {
                <div style="background-color:#e8f4fd; border-left:4px solid #2196F3; padding:10px; margin-top:10px; font-size:14px; color:#333;">

                    <strong style="color:#2196F3;">ℹ Note:</strong>
                    This <b>@Model.RuleName</b> Target is weight bound and the total weight is
                    <b>@Model.TotalWeight</b>.
                    All Criterias weight total should add to <b>@Model.TotalWeight</b>.

                    <br />

                    @{
                        var diff = Model.TotalWeight - Model.TotalCriteriaWeight;
                    }

                    So far you have added <b>@Model.TotalCriteriaWeight</b>

                    @if (diff > 0)
                    {
                        <span class="text-warning">
                            (Remaining: @diff)
                        </span>
                    }
                    else if (diff < 0)
                    {
                        <span class="text-danger">
                            (Exceeded by: @(Math.Abs(diff)))
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            (Perfect Match ✔)
                        </span>
                    }

                </div>
            }
            else
            {
                <div style="background-color:#f5f5f5; border-left:4px solid #9e9e9e; padding:10px; margin-top:10px; font-size:14px; color:#333;">
                    <strong>ℹ Note:</strong>
                    This <b>@Model.RuleName</b> Target is <b>not weight bound</b>.
                    It is an open target and criteria weights are not restricted.
                </div>
            }

            <a asp-page="/Targeting/Criterias/Index"
               asp-route-id="@Model.TargetingId"
               asp-route-ProgramId="@Model.ProgramId"
               asp-route-TargetingId="@Model.TargetingId"
               asp-route-WeightBound="@Model.WeightBound"
               asp-route-TotalWeight="@Model.TotalWeight"
               asp-route-TotalCriteriaWeight="@Model.TotalCriteriaWeight"
               asp-route-RuleName="@Model.RuleName"
               class="btn btn-sm btn-outline-secondary" style="background-color:#198754;color:ghostwhite">
                ← Back
            </a>

        </div>

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                Criteria Information
            </div>

            <div class="card-body">

                <!-- BASIC INFO -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input asp-for="Criteria.CriteriaName"
                               class="form-control"
                               required
                               readonly="@(isEdit)" />


                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Criteria.Description"
                              class="form-control"></textarea>
                </div>

                <!-- EXPRESSION -->
                <hr />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Calculated Expression
                    </label>

                    <textarea asp-for="Expression"
                              id="expressionBox"
                              class="form-control"
                              rows="4"></textarea>
                    @if (TempData["ValidationMessage"] != null)
                    {
                        var status = TempData["ValidationStatus"]?.ToString();

                        <div class="alert @(status == "success" ? "alert-success" : "alert-danger")">
                            @TempData["ValidationMessage"]
                        </div>
                    }


                </div>

                <!-- FIELD PICKER -->

                <div class="row mb-3 align-items-end g-2">

                    <!-- Indicator Dropdown -->
                    <div class="col-md-3 col-sm-6">
                        <label class="form-label small">Indicator List</label>
                        <select id="indicatorSelector" class="form-select">
                            <option value="">-- Select Indicator --</option>
                            @foreach (var item in Model.IndicatorOptions)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <!-- Add Indicator Button -->
                    <div class="col-md-2 col-sm-6">
                        <button type="button"
                                class="btn btn-outline-primary w-100"
                                onclick="addField()">
                            Add Indicator
                        </button>
                    </div>

                    <!-- Lookup Dropdown -->
                    <div class="col-md-3 col-sm-6 d-none" id="lookup-container">
                        <label class="form-label small">Lookup Value</label>
                        <select id="lookupValues" class="form-select">
                        </select>
                    </div>

                    <!-- Add Lookup Button -->
                    <div class="col-md-2 col-sm-6 d-none" id="indicatorLookupBtnContainer">
                        <button type="button"
                                class="btn btn-outline-primary w-100"
                                onclick="addLookUp()">
                            Add Value
                        </button>
                    </div>

                </div>


                <div class="row mb-3 align-items-end g-2">

                    <!-- Indicator Dropdown -->
                    <div class="col-md-2 col-sm-6">
                        <label class="form-label">Select Survey</label>
                        <select id="surveySelector" name="SurveyId" class="form-select">
                            <option value="">-- Select Survey --</option>
                            @foreach (var survey in surveys)
                            {
                                <option value="@survey.SurveyId">@survey.Title</option>
                            }
                        </select>
                    </div>

                    <!-- Survey Questions -->
                    <div class="col-md-2 col-sm-6 d-none" id="surveyQuestionContainer">
                        <label class="form-label small">Survey Questions</label>
                        <select id="surveyQuestionSelector" class="form-select">
                            <option value="">-- Survey Questions --</option>
                        </select>
                    </div>

              

                    <!-- Add Lookup Button -->
                    <div class="col-md-2 col-sm-6 d-none" id="addSurveyButton">
                        <button type="button"
                                class="btn btn-outline-primary w-100"
                                onclick="addSurveyQuestion()">
                            Add Survey Details
                        </button>
                    </div>

                    <!-- Survey Answear -->
                    <div class="col-md-2 col-sm-6 d-none" id="lookup-Answear_container">
                        <label class="form-label small">Lookup Value</label>
                        <select id="lookupAnswearValues" class="form-select">
                        </select>
                    </div>

                    <!-- Add Lookup Button -->
                    <div class="col-md-2 col-sm-6 d-none" id="surveyLookupBtnContainer">
                        <button type="button"
                                class="btn btn-outline-primary w-100"
                                onclick="addLookUpAnswear()">
                            Add Value
                        </button>
                    </div>

                </div>

                <!-- OPERATORS -->
                <div class="mb-3">

                    <div class="btn-group flex-wrap">
                        @foreach (var op in new[] { "(", ")" })
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary m-1"
                                    onclick="insert('@op')">
                                @op
                            </button>
                        }
                    </div>

                    <div class="btn-group flex-wrap mt-2">
                        @* Comparison + Logical operators *@
                        @foreach (var op in new[] { ">", ">=", "<", "<=", "==", "!=", "AND", "OR", "NOT" })
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary m-1"
                                    onclick="insert(' @op ')">
                                @op
                            </button>
                        }
                    </div>

                    <!-- String Literals / Function Keywords -->
                    <div class="mt-3 mb-1">
                        <strong>String custom operators:</strong>
                    </div>
                    <div class="btn-group flex-wrap mt-2">
                        @foreach (var op in new[] { "FUZZY", "LIKE", "STARTSWITH", "ENDSWITH", "CONTAINS" })
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary m-1"
                                    onclick="insert(' @op ')">
                                @op
                            </button>
                        }
                    </div>



                    <div style="background-color:#e8f4fd; border-left:4px solid #2196F3; padding:10px; margin-top:10px; font-size:14px; color:#333;">
                        <strong style="color:#2196F3;">ℹ Condition (Filtering) Interface</strong>
                        <p class="mb-2 mt-2">
                            This interface is used to apply conditions on existing fields or previously created indicators.
                            It supports only direct comparisons and logical combinations, such as:
                        </p>
                        <ul class="mb-2">
                            <li><code>age &gt; 10</code></li>
                            <li><code>(age &gt; 10) AND (gender == 'female')</code></li>
                            <li><code>indicator_1 &gt; 50</code></li>
                        </ul>
                        <p class="mb-2">
                            <strong>⚠️ Important:</strong>
                            This interface does <b>not</b> support creating new computed expressions within conditions.
                            For example, the following are <b>not</b> allowed:
                        </p>
                        <ul class="mb-2">
                            <li><code>age * 10 &gt; 50</code></li>
                            <li><code>age / 2 + family_size &gt; 10</code></li>
                        </ul>
                        <p class="mb-2">
                            If you need to perform any calculations, you must first define them in the
                            <b>Indicator Creation Interface</b>, and then use the resulting indicator in your condition.
                        </p>
                        <hr />
                        <p class="mb-0">
                            <strong>Text matching functions:</strong>
                            For <code>fuzzy</code>, <code>like</code>, <code>contains</code>, <code>startswith</code>, and <code>endswith</code> — use the format:
                            <code>func([FIELD_NAME], 'string value')</code>.
                            Example: <code>fuzzy([FIRST_NAME], 'j4mes')</code>,
                            <code>contains([LAST_NAME], 'son')</code>,
                            <code>startswith([CITY], 'jo')</code>.
                        </p>
                    </div>

                    <div class="row g-2 mt-3">

                        <div class="col-md-3">
                            <label class="form-label small">Score</label>
                            <input asp-for="Criteria.Score"
                                   type="number"
                                   class="form-control"
                                   min="0" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small">
                                Weight:
                                <b>
                                    @if (Model.WeightBound)
                                    {
                                        var diff2 = Model.TotalWeight - Model.TotalCriteriaWeight;

                                        <text>So far you have </text>

                                        if (diff2 > 0)
                                        {
                                            <span class="text-warning">(Remaining: @diff2)</span>
                                        }
                                        else if (diff2 < 0)
                                        {
                                            <span class="text-danger">(Exceeded by: @(Math.Abs(diff2)))</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">(Perfect Match ✔)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">(Open Target — not weight bound)</span>
                                    }
                                </b>
                            </label>

                            <input asp-for="Criteria.Weight"
                                   type="number"
                                   class="form-control"
                                   step="0.1"
                                   min="0" />
                        </div>





                    </div>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex gap-2 mt-3">

                    <button type="submit"
                            asp-page-handler="Validate"
                            class="btn btn-primary"
                            id="validateButton">
                        Validate
                    </button>

                    @if (Model.IsValidated)
                    {
                        <button type="submit"
                                asp-page-handler="GenerateJson"
                                class="btn btn-primary">
                            Generate Json
                        </button>

                        <button type="submit"
                                asp-page-handler="Save"
                                class="btn btn-success">
                            @(isEdit ? "Update Criteria" : "Create Criteria")
                        </button>

                    }
                </div>

                <!-- JSON -->
                <div class="mb-3 mt-3">
                    <label class="form-label fw-semibold">
                        Parsed Rule (JSON)
                    </label>

                    <textarea asp-for="Criteria.JsonRule"
                              id="jsonBox"
                              class="form-control auto-resize"
                              rows="4"
                              readonly></textarea>
                </div>

            </div>
        </div>
    </div>

</form>

@section Scripts {

    <script>

                // ==============================
        // ELEMENT REFERENCES
        // ==============================

        const expressionBox = document.getElementById("expressionBox");

        // Indicator
        const indicatorSelector = document.getElementById("indicatorSelector");
        const indicatorLookupContainer = document.getElementById("lookup-container");
        const indicatorLookupValues = document.getElementById("lookupValues");
        const indicatorLookupBtnContainer = document.getElementById("indicatorLookupBtnContainer");

        // Survey
        const surveySelector = document.getElementById("surveySelector");
        const surveyQuestionSelector = document.getElementById("surveyQuestionSelector");
        const surveyQuestionContainer = document.getElementById("surveyQuestionContainer");
        const addSurveyButton = document.getElementById("addSurveyButton");

        // Survey Lookup (Answer)
        const surveyLookupContainer = document.getElementById("lookup-Answear_container");
        const surveyLookupValues = document.getElementById("lookupAnswearValues");
        const surveyLookupBtnContainer = document.getElementById("surveyLookupBtnContainer");

        // ==============================
        // INSERT HELPERS
        // ==============================

        function insert(text) {
            const start = expressionBox.selectionStart;
            const end = expressionBox.selectionEnd;

            expressionBox.value =
                expressionBox.value.substring(0, start) +
                text +
                expressionBox.value.substring(end);

            expressionBox.focus();
            expressionBox.selectionStart = expressionBox.selectionEnd = start + text.length;
        }

        function insertToExpression(text) {
            insert(text);
        }

        // ==============================
        // INDICATOR LOGIC
        // ==============================

        if (indicatorSelector) {
            indicatorSelector.addEventListener("change", loadIndicatorLookups);
        }

        async function loadIndicatorLookups() {

            indicatorLookupContainer.classList.add("d-none");
            indicatorLookupBtnContainer.classList.add("d-none");
            indicatorLookupValues.innerHTML = "";

            const code = indicatorSelector.value;
            if (!code) return;

            const response = await fetch(`?handler=LookupValues&indicatorCode=${code}`);
            if (!response.ok) return;

            const data = await response.json();
            if (!data?.length) return;

            indicatorLookupContainer.classList.remove("d-none");
            indicatorLookupBtnContainer.classList.remove("d-none");

            data.forEach(item => {
                const opt = document.createElement("option");
                opt.value = item.code;
                opt.text = item.name;
                indicatorLookupValues.appendChild(opt);
            });
        }

        function addField() {
            if (!indicatorSelector.value) return;
            insertToExpression("[" + indicatorSelector.value + "]");
        }

        function addLookUp() {
            if (!indicatorLookupValues.value) return;

            const text = indicatorLookupValues.options[indicatorLookupValues.selectedIndex].text;
            insertToExpression("'" + text + "'");
        }

        // ==============================
        // SURVEY QUESTIONS
        // ==============================

        if (surveySelector) {
            surveySelector.addEventListener("change", loadSurveyQuestions);
        }

        if (surveyQuestionSelector) {
            surveyQuestionSelector.addEventListener("change", async () => {

                const questionId = surveyQuestionSelector.value;

                if (!questionId) {
                    addSurveyButton.classList.add("d-none");

                    surveyLookupContainer.classList.add("d-none");
                    surveyLookupBtnContainer.classList.add("d-none");
                    surveyLookupValues.innerHTML = "";
                    return;
                }

                addSurveyButton.classList.remove("d-none");

                // 🔥 Load lookup values using lookupId
                await loadSurveyQuestionLookups();
            });
        }

        async function loadSurveyQuestions() {

            surveyQuestionSelector.innerHTML = '<option value="">-- Survey Questions --</option>';
            surveyQuestionContainer.classList.add("d-none");
            addSurveyButton.classList.add("d-none");

            const surveyId = surveySelector.value;
            if (!surveyId) return;

            const response = await fetch(`?handler=SurveyQuestions&surveyId=${surveyId}`);
            if (!response.ok) return;

            const data = await response.json();
            if (!data?.length) return;

            data.forEach(item => {
                const opt = document.createElement("option");

                const id = item.questionId ?? item.id ?? item.surveyQuestionId;
                const text = item.text ?? item.questionText ?? item.label ?? item.name ?? `Question ${id}`;

                if (id == null) return;

                opt.value = id;
                opt.text = text;

                // 🔥 store lookupId
                opt.dataset.lookupId = item.lookupId;

                surveyQuestionSelector.appendChild(opt);
            });

            if (surveyQuestionSelector.options.length > 1) {
                surveyQuestionContainer.classList.remove("d-none");
            }
        }

        function addSurveyQuestion() {
            const surveyId = surveySelector.value;
            const questionId = surveyQuestionSelector.value;

            if (!surveyId || !questionId) return;

            insertToExpression(`[survey_${surveyId}_q_${questionId}]`);
        }

        // ==============================
        // SURVEY LOOKUPS (ANSWER VALUES)
        // ==============================

        async function loadSurveyQuestionLookups() {

            surveyLookupContainer.classList.add("d-none");
            surveyLookupBtnContainer.classList.add("d-none");
            surveyLookupValues.innerHTML = "";

            const selectedOption =
                surveyQuestionSelector.options[surveyQuestionSelector.selectedIndex];

            const lookupId = selectedOption?.dataset?.lookupId;

            if (!lookupId) return;

            const response = await fetch(`?handler=LookupValuesByLookupId&lookupId=${lookupId}`);
            if (!response.ok) return;

            const data = await response.json();
            if (!data?.length) return;

            // 🔥 SHOW BOTH ELEMENTS
            surveyLookupContainer.classList.remove("d-none");
            surveyLookupBtnContainer.classList.remove("d-none");

            data.forEach(item => {
                const opt = document.createElement("option");
                opt.value = item.code ?? item.value ?? item.id;
                opt.text = item.name ?? item.text ?? item.label;
                surveyLookupValues.appendChild(opt);
            });
        }

        function addLookUpAnswear() {
            if (!surveyLookupValues.value) return;

            const text = surveyLookupValues.options[surveyLookupValues.selectedIndex].text;
            insertToExpression("'" + text + "'");
        }

        // ==============================
        // VALIDATION RESET
        // ==============================

        expressionBox.addEventListener("input", () => {
            const hidden = document.querySelector('input[name="IsValidated"]');
            if (hidden) hidden.value = "false";
        });

        // ==============================
        // CLEAR JSON ON VALIDATE
        // ==============================

        document.getElementById("validateButton")
            ?.addEventListener("click", () => {
                const jsonBox = document.getElementById("jsonBox");
                if (jsonBox) jsonBox.value = "";
            });

        // ==============================
        // AUTO RESIZE JSON BOX
        // ==============================

        function autoResize(el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        }

        window.addEventListener("load", () => {
            const jsonBox = document.getElementById("jsonBox");
            if (jsonBox) autoResize(jsonBox);
        });

    </script>

}
