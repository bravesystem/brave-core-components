@page
@using BRaVe_Portal.Models.Enums
@model BRaVe_Portal.Pages.Targeting.ApplyTargettingModel
@{
    ViewData["Title"] = "Apply Targeting"; 
}




@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container py-10">



    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Targeting Jobs</h1>
            <p class="text-muted">Select criteria to identify target population</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-page-handler="Apply" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()

                <div class="col-md-3">

                    <select id="TargetSelect"
                            class="form-select"
                            asp-for="TargetingId"
                            required>

                        <option value="">-- Select Targeting Rule --</option>

                        @if (Model.TargetingRules != null)
                        {
                            foreach (var d in Model.TargetingRules)
                            {
                                <option value="@d.Id">@d.RuleName</option>
                            }
                        }
                    </select>

                </div>

                <div class="col-md-3">
                    <input type="date" class="form-control" asp-for="FromDate" required>

                </div>

                <div class="col-md-3">
                    <input type="date" class="form-control" asp-for="ToDate" required>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Apply</button>
                </div>
            </form>
        </div>
    </div>


     


            <!-- Targeting Jobs Table -->

    <div class="card shadow-sm border-0 mt-4">

                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
                    <h5 class="mb-0">Targeting Jobs</h5>

                    <div class="btn-group">
                <button type="button"
                        class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2"
                        onclick="refreshPage(this)">
                    <i class="fa-solid fa-rotate"></i>
                    <span>Refresh</span>
                </button>



                
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Job ID</th>
                                    <th>Targeting Rule</th>
                                    <th>Start Period</th>
                                    <th>End Period</th>
                                    <th>Created By</th>
                                    <th>Created On</th>
                                    <th>Completed On</th>

                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>

                    <tbody>
                        @if (Model.Jobs.Any())
                        {
                            foreach (var job in Model.Jobs.OrderBy(j => j.Order).ThenByDescending(j => j.CreatedOn))
                            {
                                <tr>
                                    <td>JOB-@job.Id</td>
                                    <td>@job.TargetingRule</td>
                                    <td>@job.StartPeriod.ToString("dd MMM yyyy")</td>
                                    <td>@job.EndPeriod.ToString("dd MMM yyyy")</td>
                                    <td>@job.CreatedBy</td>
                                    <td>@job.CreatedOn.ToString("dd MMM yyyy")</td>
                                    <!-- COMPLETED ON -->
                                    <td>
                                        @(job.CompletedOn.HasValue
                                                                        ? job.CompletedOn.Value.ToString("dd MMM yyyy")
                                                                        : "-")
                                    </td>

                                    <!-- STATUS -->
                                    <td>
                                        @switch (job.StatusId)
                                        {
                                            case 1:
                                                <span class="badge bg-secondary">Pending</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-warning text-dark">Running</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case 4:
                                                <span class="badge bg-dark">Completed (Disabled)</span>
                                                break;
                                            case 5:
                                                <span class="badge bg-danger">Failed</span>
                                                break;
                                        }
                            </td>

                       

                                    <!-- ACTIONS -->
                                    <td class="text-end">
                                @if (job.StatusId == JobStatus.Completed)
                                        {
                                            <a asp-page="/Targeting/TargetingResults"
                                               asp-route-jobId="@job.Id"
                                               asp-route-targetingId="@job.TargetingId"
                                               asp-route-targetingRule="@job.TargetingRule"
                                               asp-route-fromDate="@job.StartPeriod.ToString("yyyy-MM-dd")"
                                               asp-route-toDate="@job.EndPeriod.ToString("yyyy-MM-dd")"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                     
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-open-clear-modal"
                                                    data-jobid="@job.Id">
                                                Clear
                                            </button>


                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    No targeting jobs found.
                                </td>
                            </tr>
                        }
                    </tbody>

                        </table>


                <form method="post"
                      asp-page-handler="ClearJob"
                      id="clearJobForm"
                      class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobId" id="clearJobId" />
                </form>



               

                    </div>

            @if (Model.TotalPages > 0)
            {
                <nav class="p-3">
                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./ApplyTargetting"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-page="./ApplyTargetting"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./ApplyTargetting"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                Next
                            </a>
                        </li>

                    </ul>
                </nav>
            }
                </div>
            </div>
            </div>


           <!--Confirmation modal-->
<div class="modal fade" id="clearJobModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Clear</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="mb-0">
                    Are you sure you want to clear the targeting results for
                    job:
                    <strong id="modalJobId"></strong> ?
                </p>
                <small class="text-muted">
                    This action will clear all results for this job.
                </small>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="confirmClearJob">
                    Yes, Clear Results
                </button>
            </div>

        </div>
    </div>
</div>


    <script>
        function refreshPage(button) {
            const icon = button.querySelector("i");

            button.disabled = true;
            icon.classList.add("fa-spin");

            setTimeout(() => {
                location.reload();
            }, 500);
        }
    </script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        let selectedJobId = null;
        const modal = new bootstrap.Modal(document.getElementById('clearJobModal'));

        // Open modal
        document.querySelectorAll(".btn-open-clear-modal").forEach(btn => {
            btn.addEventListener("click", function () {

                selectedJobId = this.dataset.jobid;

                document.getElementById("modalJobId").textContent = "JOB-" + selectedJobId;
                document.getElementById("clearJobId").value = selectedJobId;

                modal.show();
            });
        });

        // Confirm clear
        document.getElementById("confirmClearJob")
            .addEventListener("click", function () {

                if (!selectedJobId) return;

                document.getElementById("clearJobForm").submit();
            });

    });
</script>




           
