@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Models.DTOs.ProgramDto

@{
    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.CommonStatuses ?? new List<LookupItemDto>();
}

<div class="modal fade" id="editProgramModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Program</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form method="post" asp-page-handler="EditProgram" id="editProgramForm">
                    <input type="hidden" asp-for="ProgramId" id="editProgramId" />

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" id="editProgramTitle" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" id="editProgramDescription"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label asp-for="StatusId" class="form-label">Status</label>
                        <select asp-for="StatusId" class="form-select" id="editProgramActive">
                            <option value="">-- Select Status --</option>
                            @foreach (var s in lookups)
                            {
                                <option value="@s.Id">@s.Text</option>
                            }
                        </select>
                        <span asp-validation-for="StatusId" class="text-danger"></span>
                    </div>

                    <!-- Hidden aggregated CSV of selected user ids (kept for server parsing) -->
                    <input type="hidden" id="Edit_SelectedUserIdsHidden" name="SelectedRoleIds" />

                    <!-- Assign users toggle + single combined multi-select -->
                    <div class="mb-3">
                        <button type="button"
                                class="btn d-flex align-items-center gap-2"
                                style="background-color:#0d47a1; color:white;"
                                data-bs-toggle="collapse"
                                data-bs-target="#editRoleAssignmentCollapse"
                                aria-expanded="false"
                                aria-controls="editRoleAssignmentCollapse"
                                id="toggleEditRoleAssignBtn">
                            <i class="fa fa-user-plus"></i>
                            <span>Assigned users</span>
                            <span class="badge bg-light text-dark ms-2" id="editTotalUsersBadge">0</span>
                            <i class="fa fa-chevron-down ms-auto rotate-icon text-light" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="collapse" id="editRoleAssignmentCollapse">
                        <div class="card card-body border-0 shadow-sm rounded-3">
                            <div class="row gy-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                                      
                                        <small class="text-muted"><span id="editUsersCount">0</span> selected</small>
                                    </label>

                                    <!-- combined single multi-select -->
                                    <select id="edit_rolesUsers" class="form-select role-select" multiple size="10" data-group="users">
                                        @foreach (var u in (ViewData["SystemUsers"] as List<SystemUserDto> ?? new List<SystemUserDto>()))
                                        {
                                            <option value="@u.UserId">
                                                @u.ProfileName
                                                @if (u.Roles != null && u.Roles.Any())
                                                {
                                                    <text> (</text>
                                                    <span class="text-primary">@string.Join(", ", u.Roles)</span>
                                                    <text>)</text>
                                                }
                                            </option>
                                        }



                                    </select>
                                </div>
                            </div>

                            <div class="mt-3 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-outline-secondary" id="editClearRoleSelections">Clear</button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-save me-1"></i> Update
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


