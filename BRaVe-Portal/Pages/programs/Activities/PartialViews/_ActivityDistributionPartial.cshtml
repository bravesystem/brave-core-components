@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model IEnumerable<BRaVe_Portal.Models.ActivityDistributors>
@{
    var activityId = ViewData["ActivityId"] as int? ?? 0;

    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.SurveyTypes ?? new List<LookupItemDto>();
}

@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Distributors")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Distributors")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>TITLE</th>
                        <th>TYPE</th>
                        <th>MODE</th>
                        <th>BIOMETRIC</th>
                        <th>PHOTO</th>
                    
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dis in Model)
                    {
                        <tr>
                            <td>@dis.DistributionId</td>
                            <td>@dis.Name</td>
                            <td>@LookupHelper.GetTextById(lookups, @dis.DistributionType)</td>
                            <td>@dis.Mode</td>
                            <td>
                                <span class="badge @(dis.Biometric == true ? "bg-success" : "bg-secondary")">
                                    @(dis.Biometric == true ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(dis.Photo == true ? "bg-success" : "bg-secondary")">
                                    @(dis.Photo == true ? "Yes" : "No")
                                </span>
                            </td>
                         
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                        data-id="@dis.DistributionId"
                                        data-activityid="@activityId"
                                        data-name="@dis.Name"
                                        data-entity="distribution"
                                        data-handler="RemoveDistributionFromActivity"
                                        data-bs-toggle="modal"
                                        data-bs-target="#DeleteModal">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No distribution defined for this activity yet.</p>
        }
    </div>
</div>
