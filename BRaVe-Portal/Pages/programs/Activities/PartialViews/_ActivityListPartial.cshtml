@model IEnumerable<BRaVe_Portal.Models.ViewModels.ActivityViewModel>


@if ((Model?.Count() ?? 0) > 0)
{
    <div class="card shadow-sm">

    <div class="card-body">
        <div class="card-header bg-primary text-white fw-bold">Activities</div>
        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Activity Code</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Start</th>
                        <th>End</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in Model)
                    {
                        <tr>
                            <td>@activity.ActivityCode</td>
                            <td>@activity.Title</td>
                            <td>@activity.Description</td>
                            <td>@activity.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@activity.EndDate.ToString("yyyy-MM-dd")</td>

                                <td>
                                    <a class="btn btn-sm btn-primary btn-with-spinner"
                                       href="@Url.Page("/programs/Activities/ViewEditActivity", new { id = activity.ActivityId })">
                                        <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                                        <i class="fa fa-eye"></i>
                                    </a>
                                </td>

                       
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>
}
else
{
    <div>
        <h4 class="alert-heading">No Activities Found</h4>
    </div>
}
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // -------------------------------
            // Show Activity Panel
            // -------------------------------
            function showActivity(activityId) {
                const panel = document.getElementById('viewActivityPanel');
                if (!panel.classList.contains('show')) {
                    panel.classList.add('show');
                }
                panel.scrollIntoView({ behavior: 'smooth' });
            }

            // -------------------------------
            // Show spinner inside a button
            // -------------------------------
            function showButtonSpinner(button) {
                const spinner = button.querySelector(".spinner-border");
                if (spinner) spinner.classList.remove("d-none");
                button.disabled = true; // prevent double clicks

                // Timeout fallback (5s) in case navigation fails
                setTimeout(() => {
                    if (spinner && !spinner.classList.contains("d-none")) {
                        spinner.classList.add("d-none");
                        button.disabled = false;
                        alert("Request timed out. Please try again.");
                    }
                }, 5000); // 5 seconds
            }

            // -------------------------------
            // Attach click handler for buttons/links with spinner
            // -------------------------------
            document.querySelectorAll(".btn-with-spinner").forEach(button => {
                button.addEventListener("click", function (e) {
                    showButtonSpinner(button);

                    // For links, allow navigation after short delay
                    const href = button.getAttribute("href");
                    if (href) {
                        setTimeout(() => { window.location = href; }, 50);
                        e.preventDefault(); // small delay to show spinner
                    }
                });
            });

            // -------------------------------
            // Attach submit handler for forms
            // -------------------------------
            document.querySelectorAll("form").forEach(form => {
                form.addEventListener("submit", function () {
                    const submitButton = form.querySelector("button[type='submit']");
                    if (submitButton) showButtonSpinner(submitButton);
                });
            });

        });
    </script>
}
