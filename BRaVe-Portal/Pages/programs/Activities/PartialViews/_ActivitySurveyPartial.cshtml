@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model List<BRaVe_Portal.Models.ActivitySurveys>
@{
    ViewData["Title"] = "Surveys";
    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.SurveyTypes ?? new List<LookupItemDto>();
    var activityId = ViewData["ActivityId"] as int? ?? 0;
}

@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Survey")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Survey")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Required</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var survey in Model)
                    {
                        <tr>
                            <td>@survey.SurveyId</td>
                            <td>@survey.Title</td>
                            <td>@LookupHelper.GetTextById(lookups, @survey.SurveyType)</td>
                            <td>
                                @if (survey.IsRequired)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                        data-id="@survey.SurveyId"
                                        data-activityid="@activityId"
                                        data-name="@survey.Title"
                                        data-entity="survey"
                                        data-handler="RemoveSurveyFromActivity"
                                        data-bs-toggle="modal"
                                        data-bs-target="#DeleteModal">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No Surveys have been added to this activity yet.</p>
        }
    </div>
</div>
