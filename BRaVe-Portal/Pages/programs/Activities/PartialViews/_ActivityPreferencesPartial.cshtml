@using BRaVe_Portal.Models
@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models.DTOs
@model IEnumerable<BRaVe_Portal.Models.ActivityPreference>
@{
    var activityId = ViewData["ActivityId"] as int? ?? 0;

    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var dataTypelookUp = coreLookups?.PreferenceTypes ?? new List<LookupItemDto>();
}

@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Preference")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "Preference")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Id</th>
                        <th>Setting Name</th>
                        <th>Type</th>
                        <th>Default Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pref in Model)
                    {
                        <tr>
                            <td>@pref.PreferenceId</td>
                            <td>@pref.PreferenceName</td>
                            <td>@LookupHelper.GetTextById(dataTypelookUp, pref.PreferenceType)</td>
                            <td>@(pref.DefaultValue?.ToUpper())</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                        data-id="@pref.PreferenceId"
                                        data-activityid="@activityId"
                                        data-name="@pref.PreferenceName"
                                        data-entity="preference"
                                        data-handler="RemoveAPrefferenceFromActivity"
                                        data-bs-toggle="modal"
                                        data-bs-target="#DeleteModal">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No default preferences defined for this activity yet.</p>
        }
    </div>
</div>
