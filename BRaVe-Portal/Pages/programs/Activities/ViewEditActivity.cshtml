@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {


            function initLocationCascade(container) {
                debugger;
                if (!container || container.dataset.initialized === 'true') return;
                container.dataset.initialized = 'true';

                const endpoint = container.dataset.endpoint;

                const selects = Array.from(container.querySelectorAll('select[data-level-index]'));

                function clearSelect(select) {
                    const label = select.previousElementSibling?.textContent?.trim() || 'Location';
                    select.innerHTML = `<option value="">-- Select ${label} --</option>`;
                    select.value = '';
                    select.disabled = true;
                }

                function fillSelect(select, items) {
                    clearSelect(select);
                    items.forEach(item => {
                        const option = document.createElement('option');
                        option.value = item.id;
                        option.textContent = item.name;
                        select.appendChild(option);
                    });
                    select.disabled = false;
                }

                async function loadChildren(nextSelect, levelId, parentLocationId) {
                    const url = new URL(endpoint, window.location.origin);
                    url.searchParams.set('levelId', String(levelId));
                    url.searchParams.set('parentLocationId', String(parentLocationId));
                    const response = await fetch(url.toString(), { method: 'GET' });
                    if (!response.ok) return;
                    const data = await response.json();
                    fillSelect(nextSelect, data || []);
                }

                selects.forEach(select => {
                    select.addEventListener('change', async function () {
                        debugger;
                        const currentIndex = Number(this.dataset.levelIndex);
                        const selectedParentId = this.value ? Number(this.value) : null;

                        for (let i = currentIndex + 1; i < selects.length; i++) {
                            clearSelect(selects[i]);
                        }

                        const nextSelect = selects[currentIndex + 1];
                        if (!nextSelect || !selectedParentId) return;

                        const nextLevelId = Number(nextSelect.id.replace('admin-level-', ''));
                        try {
                            await loadChildren(nextSelect, nextLevelId, selectedParentId);
                        } catch {
                            clearSelect(nextSelect);
                        }
                    });
                });
            }

            initLocationCascade(document.getElementById('locationCascadeContainer'));


            // --- EDIT ACTIVITY MODAL ---
            const editModal = document.getElementById('editActivityModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;

                    document.getElementById('editActivityId').value = button.getAttribute('data-id');
                    document.getElementById('editTitle').value = button.getAttribute('data-title');
                    document.getElementById('editDescription').value = button.getAttribute('data-description');
                    
                    document.getElementById('editStartDate').value = button.getAttribute('data-start');
                    document.getElementById('editEndDate').value = button.getAttribute('data-end');
                    document.getElementById('editRestrictToEnumerator').checked =
                        button.getAttribute('data-restrict') === 'true';
                    document.getElementById('editLatitude').value = button.getAttribute('data-latitude');
                    document.getElementById('editLongitude').value = button.getAttribute('data-longitude');
                });
            }

            // --- DELETE CONFIRMATION MODAL ---
            const form = document.getElementById('delete-form');
            if (form) {
                document.querySelectorAll('.delete-button').forEach(button => {
                    button.addEventListener('click', () => {
                        const id = button.getAttribute('data-id');
                        const activityId = button.getAttribute('data-activityid');
                        const name = button.getAttribute('data-name');
                        const entity = button.getAttribute('data-entity');
                        const handler = button.getAttribute('data-handler');

                        document.getElementById('delete-id').value = id;
                        document.getElementById('delete-activity-id').value = activityId;
                        document.getElementById('delete-name').textContent = name;
                        document.getElementById('delete-entity').textContent = entity;

                        const url = new URL(window.location.href);
                        url.searchParams.set('handler', handler);
                        form.action = url.pathname + url.search;
                    });
                });
            }

            // --- BUTTON SPINNER HANDLER ---
            function showButtonSpinner(button) {
                const spinner = button.querySelector(".spinner-border");
                if (spinner) spinner.classList.remove("d-none");
                button.disabled = true;

                // Timeout fallback (5s)
                setTimeout(() => {
                    if (spinner && !spinner.classList.contains("d-none")) {
                        spinner.classList.add("d-none");
                        button.disabled = false;
                        alert("Request timed out. Please try again.");
                    }
                }, 5000);
            }

            // Attach click handler for buttons/links with spinner
            document.querySelectorAll(".btn-with-spinner").forEach(button => {
                button.addEventListener("click", function (e) {
                    showButtonSpinner(button);

                    // For links, allow navigation
                    const href = button.getAttribute("href");
                    if (href) {
                        setTimeout(() => { window.location = href; }, 50);
                        e.preventDefault();
                    }
                });
            });

            // Attach submit handler for forms
            document.querySelectorAll("form").forEach(form => {
                form.addEventListener("submit", function () {
                    const submitButton = form.querySelector("button[type='submit']");
                    if (submitButton) showButtonSpinner(submitButton);
                });
            });





        });
    </script>
}