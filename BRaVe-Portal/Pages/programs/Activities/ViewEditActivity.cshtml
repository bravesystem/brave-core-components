        <i class="fa-solid fa-arrow-left"></i> Back
    </a>

</div>
<div>
    <br />

</div>

<div id="activityDetails" class="alert alert-info mb-4 mx-auto w-100 w-md-50">
    @if (Model.SelectedActivity != null)
    {
        <p class="mb-3">
            <i class="fa-solid fa-circle-info me-2"></i>
            <strong>Note:</strong> Activity - <strong>@Model.SelectedActivity.Title</strong>.
        </p>

        <table class="table table-borderless align-middle mb-0" style="--bs-table-bg: transparent;">
            <tr>
                <td><strong>Activity Code:</strong></td>
                <td>@Model.SelectedActivity.ActivityCode</td>
            </tr>
            <tr>
                <td><strong>Title:</strong></td>
                <td>@Model.SelectedActivity.Title</td>
            </tr>
            <tr>
                <td><strong>Description:</strong></td>
                <td class="description-cell">@Model.SelectedActivity.Description</td>
            </tr>
            <tr>
                <td><strong>Start Date:</strong></td>
                <td>@Model.SelectedActivity.StartDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td><strong>End Date:</strong></td>
                <td>@Model.SelectedActivity.EndDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td><strong>Location/Site:</strong></td>
                <td>@Model.LocationCascade.getSiteFullAddress()</td>
            </tr>
            <tr>
                <td><strong>Latitude:</strong></td>
                <td>@Model.SelectedActivity.latitude</td>
            </tr>
            <tr>
                <td><strong>Longitude:</strong></td>
                <td>@Model.SelectedActivity.Longitude</td>
            </tr>
            <tr>
                <td><strong>Enumerator Restricted:</strong></td>
                <td>@(Model.SelectedActivity.RestrictToEnumerator ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td><strong>Allow registration:</strong></td>
                <td>@(Model.SelectedActivity.AllowRegistration ? "Yes" : "No")</td>
            </tr>
            <tr>
                <td><strong>Allow biometric record check:</strong></td>
                <td>@(Model.SelectedActivity.AllowBiometricRecordCheck ? "Yes" : "No")</td>
            </tr>

            <tr>
                <td><strong>Download Status</strong></td>
                <td>

                    @if (@Model.SelectedActivity.IsActive)
                    {
                        <span class="badge bg-success">
                            <i class="fa fa-check"></i>
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            <i class="fa fa-times"></i>
                        </span>
                    }

                </td>
            </tr>
        </table>

        <div class="d-flex justify-content-end mb-3 w-100">


            @if (!Model.SelectedActivity.IsActive)
            {
                <form method="post" asp-page-handler="ValidateActivity" class="me-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" value="@Model.SelectedActivity.ActivityId" />
                    <button type="submit"
                            class="btn btn-outline-success"
                            id="validateActivityBtn">
                        <i class="fa-solid fa-check"></i> Activate
                    </button>
                </form>

            }
            else
            {
                <form method="post" asp-page-handler="InvalidateActivity" class="me-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" value="@Model.SelectedActivity.ActivityId" />
                    <button type="submit"
                            class="btn btn-outline-danger"
                            id="invalidateActivityBtn">
                        <i class="fa-solid fa-ban"></i> De-activate
                    </button>
                </form>
            }


            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#editActivityModal"
                    data-id="@Model.SelectedActivity.ActivityId"
                    data-title="@Model.SelectedActivity.Title"
                    data-description="@Model.SelectedActivity.Description"
                    data-start="@Model.SelectedActivity.StartDate.ToString("yyyy-MM-dd")"
                    data-end="@Model.SelectedActivity.EndDate.ToString("yyyy-MM-dd")"
                    data-restrict="@Model.SelectedActivity.RestrictToEnumerator.ToString().ToLower()"
                    data-latitude="@Model.SelectedActivity.latitude"
                    data-longitude="@Model.SelectedActivity.Longitude">
                <i class="fa fa-edit"></i> Edit Activity
            </button>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-0">
            No activity selected. Please pick one from the list.
        </div>
    }
</div>

<style>
    .description-cell {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
        max-width: 50vw;
    }
</style>


