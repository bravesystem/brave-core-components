@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Pages.programs.Activities.ViewEditActivityModel

@{
    var activityId = Model.SelectedActivity?.ActivityId ?? 0;
    var surveys = Model.AvailableSurveys ?? new List<Survey>();
}

<div class="modal fade" id="addSurveyToActivityModal" tabindex="-1" aria-labelledby="addSurveyToActivityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSurveyToActivityModalLabel">Attach Survey to Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AddSurveyToActivity">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ActivityId" value="@activityId" />

                    <strong style="color:#2196F3;">ℹ Note:</strong>
                    Only active surveys will be displayed here.

                    <div class="mb-3">
                        <label class="form-label">Select Survey</label>
                        <select name="SurveyId" class="form-select" required>
                            <option value="">-- Select Survey --</option>
                            @foreach (var survey in surveys)
                            {
                                <option value="@survey.SurveyId">@survey.Title</option>
                            }
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Required" type="checkbox" class="form-check-input" />
                        <label asp-for="Required" class="form-check-label">Is Required?</label>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-save"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
