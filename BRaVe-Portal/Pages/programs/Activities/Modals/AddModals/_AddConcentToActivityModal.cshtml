@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@using BRaVe_Portal.Models.ViewModels
@model BRaVe_Portal.Pages.programs.Activities.ViewEditActivityModel

@{
    var activityId = Model.SelectedActivity?.ActivityId ?? 0;
    var consents = Model.AvailableConsents ?? new List<ConcentViewModel>();
    Models.CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.SurveyTypes ?? new List<LookupItemDto>();
    ;
}

<div class="modal fade" id="addConcentToActivityModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Consent to Activity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="AddConsentToActivity">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="activityId" value="@activityId" />
                   
                    <div class="mb-3">
                        <label class="form-label">Select Consent</label>
                        <select name="consentId" class="form-select" required>
                            <option value="">-- Select Consent --</option>
                            @foreach (var consent in consents)
                            {
                                <option value="@consent.Id">@consent.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Select Consent Type</label>
                        <select name="ConsentType" class="form-select" required>
                            <option value="">-- Select Consent --</option>
                            @foreach (var consentType in lookups)
                            {
                                <option value="@consentType.Id">@consentType.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Required" type="checkbox" class="form-check-input" />
                        <label asp-for="Required" class="form-check-label">Is Required?</label>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-save"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
