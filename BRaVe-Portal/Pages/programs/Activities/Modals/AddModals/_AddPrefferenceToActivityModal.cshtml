@model BRaVe_Portal.Pages.programs.Activities.ViewEditActivityModel
@using BRaVe_Portal.Models

@{
    var activityId = Model.SelectedActivity?.ActivityId ?? 0;

    var preferences = Model.AllAvailablePreferences;
    var hasPreferences = preferences.Any();
}

<div class="modal fade" id="addPrefferenceToActivityModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Attach Preferences</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form method="post" asp-page-handler="AddPreferenceToActivity">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ActivityId" value="@activityId" />

                    @if (!hasPreferences)
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-center">
                            <span>
                                This mission has no attached preferences. Kindly attach them first.
                            </span>

                            <a asp-page="/Preferences/Index"
                               class="btn btn-primary btn-sm ms-3">
                                <i class="fa fa-sliders me-1"></i>
                                Go to Preferences
                            </a>
                        </div>
                    }

                    else
                    {
                        <table class="table table-sm table-bordered align-middle mb-3">
                            <thead class="table-light">
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th>Default Value</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var pref in preferences)
                                {
                                    <tr>
                                        <td>@pref.PreferenceId</td>
                                        <td>@pref.PreferenceName</td>
                                        <td>@pref.Description</td>
                                        <td>@pref.PreferenceType</td>

                                        <input type="hidden" name="PreferenceTypes[@pref.PreferenceId]" value="@pref.PreferenceType" />
                                     
                                        <td>
                                            @* BOOLEAN *@
                                            @if (pref.PreferenceType?.Equals("boolean", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <select class="form-select pref-input"
                                                        name="PreferenceValues[@pref.PreferenceId]">
                                                    <option value="true" selected="@(pref.DefaultValue == "true")">True</option>
                                                    <option value="false" selected="@(pref.DefaultValue == "false")">False</option>
                                                </select>
                                            }
                                            @* INT / NUMERIC *@
                                            else if (pref.PreferenceType?.Equals("int", StringComparison.OrdinalIgnoreCase) == true
                                            || pref.PreferenceType?.Equals("numeric", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <input type="number"
                                                       class="form-control form-control-sm pref-input"
                                                       name="PreferenceValues[@pref.PreferenceId]"
                                                       value="@pref.DefaultValue" />
                                            }
                                            @* TEXT *@
                                            else
                                            {
                                                <input type="text"
                                                       class="form-control form-control-sm pref-input"
                                                       name="PreferenceValues[@pref.PreferenceId]"
                                                       value="@pref.DefaultValue" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="fa fa-save me-2"></i> Attach Preferences
                            </button>
                        </div>
                    }
                </form>
            </div>

        </div>
    </div>
</div>
