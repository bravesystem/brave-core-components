
@{
    var codeValue = TempData["SessionCode"]?.ToString() ?? "";
}
<div class="modal fade" id="ClaimCodeModal" data-recovery-code="@(codeValue)" tabindex="-1" aria-labelledby="ClaimCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content" style="border-radius:12px;box-shadow:0 12px 40px rgba(2,6,23,0.16);">
            <div class="modal-header" style="background: linear-gradient(90deg, rgba(0,45,114,0.03), transparent); border-bottom:1px solid #eef2ff;">
                <h5 class="modal-title fw-bold" id="ClaimCodeModalLabel" style="color:#002d72;margin:0;font-size:18px;">Save your claim code</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal" aria-label="Close">Close</button>
            </div>

            <div class="modal-body text-center" style="padding:22px;">
                <div id="claimCodePill" class="mx-auto" style="display:inline-block;padding:18px 26px;border-radius:10px;background:#f1f5ff;
             border:1px dashed rgba(2,45,114,0.12);font-family:ui-monospace,monospace;font-size:20px;letter-spacing:2px;color:#002d72;">
                </div>

                <div class="d-flex justify-content-center gap-2 mt-3" style="flex-wrap:wrap;">
                   
                    <button type="button" class="btn btn-sm btn-light" id="claimCopyBtn" data-no-loader>Copy</button>
                    <button type="button" class="btn btn-sm btn-light" id="claimDownloadBtn" data-no-loader>Download</button>
                    <button type="button" class="btn btn-sm btn-light" id="claimShareBtn" data-no-loader>Share</button>
                </div>

                <div class="text-muted small mt-3">Print or save this code in a secure place. Closing the popup will clear it.</div>
            </div>


        </div>
    </div>
</div>
