@model IEnumerable<Models.ViewModels.DataProcessingDataDisclosureRecipient>


@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs


@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.DataDisclosureRecipients ?? new List<LookupItemDto>();

    bool IsReadOnly = ViewData["IsReadOnly"] != null && (bool)ViewData["IsReadOnly"];

}

@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "DisclosureRecipient")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "DisclosureRecipient")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Category</th>
            <th>Category Name</th>
            <th>Department</th>
            <th>Purpose of disclosure</th>
            <th>Aggregated?</th>
            <th>Anonymized?</th>
            <th>Purpose of access</th>
            <th style="width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>
          @if (Model.Count() == 0)
        {
            <tr class="alert alert-warning text-center mt-5 p-4 rounded shadow-sm">
                <td colspan="8">
                    No data disclosure recipients available.
                </td>
            </tr>
        }
        else
            @foreach (var c in Model)
            {
                <tr>
                    <td> @LookupHelper.GetTextById(lookups, @c.RecipientId)</td>
                    <td> @c.RecipientOther</td>
                    <td> @c.NameOfRecipientDepartment</td>
                    <td> @c.PurposeOfDataDisclosure</td>
                    <td>
                        @if (c.IsDataAggregatedBeforeSharing)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times text-danger"></i>
                        }
                    </td>
                    <td>
                        @if (c.IsDataAnonymizedBeforeSharing)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times text-danger"></i>
                        }
                    </td>
                    <td>@c.PurposeOfDataAccess</td>
                    <td>
                        

                        @if (!IsReadOnly)
                        {

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editDisclosureRecipientModal"
                                    data-DisclosureRecipientAssessment="@c.AssessmentId"
                                    data-RecipientId="@c.RecipientId"
                                    data-DisclosureRecipientOther="@c.RecipientOther"
                                    data-NameOfRecipientDepartment="@c.NameOfRecipientDepartment"
                                    data-PurposeOfDataAccess="@c.PurposeOfDataAccess"
                                    data-IsDataAggregatedBeforeSharing="@c.IsDataAggregatedBeforeSharing"
                                    data-IsDataAnonymizedBeforeSharing="@c.IsDataAnonymizedBeforeSharing"
                                    data-PurposeOfDataDisclosure="@c.PurposeOfDataDisclosure">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                    data-id="@c.RecipientId"
                                    data-assessment-id="@c.AssessmentId"
                                    data-name="@LookupHelper.GetTextById(lookups, @c.RecipientId)"
                                    data-bs-toggle="modal" data-bs-target="#DeleteModal" data-handler="DeleteDisclosureRecipient"
                                    data-entity="disclosure recipient">
                                <i class="fa fa-trash"></i>
                            </button>


                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">View-only</span>
                            <i class="fa-solid fa-lock ms-2 text-muted" data-bs-toggle="tooltip" title="Read-only: no actions"></i>

                        }

                    </td>         
        </tr>
        }
    </tbody>
</table>

<!--Populate edit form-->

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var editModal = document.getElementById("editDisclosureRecipientModal");

        editModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;

            // Get values from button attributes
            var assessmentId = button.getAttribute("data-DisclosureRecipientAssessment");
            var RecipientId = button.getAttribute("data-RecipientId");
            var RecipientOther = button.getAttribute("data-DisclosureRecipientOther");
            var NameOfRecipientDepartment = button.getAttribute("data-NameOfRecipientDepartment");
            var PurposeOfDataAccess = button.getAttribute("data-PurposeOfDataAccess");

            var IsDataAggregatedBeforeSharing = "True"==button.getAttribute("data-IsDataAggregatedBeforeSharing");
            var IsDataAnonymizedBeforeSharing = "True"==button.getAttribute("data-IsDataAnonymizedBeforeSharing");

            var PurposeOfDataDisclosure = button.getAttribute("data-PurposeOfDataDisclosure");

            // Fill modal form
            document.getElementById("editDisclosureRecipientAssessmentId").value = assessmentId;
            document.getElementById("selectedRecipientId").value = RecipientId;
            document.getElementById("editRecipientId").value = RecipientId;
            document.getElementById("editDisclosureRecipientOther").value = RecipientOther;
            document.getElementById("editNameOfRecipientDepartment").value = NameOfRecipientDepartment;
            document.getElementById("editPurposeOfDataAccess").value = PurposeOfDataAccess;
            document.getElementById("editIsDataAggregatedBeforeSharing").checked = IsDataAggregatedBeforeSharing;
            document.getElementById("editIsDataAnonymizedBeforeSharing").checked = IsDataAnonymizedBeforeSharing;
            document.getElementById("editPurposeOfDataDisclosure").value = PurposeOfDataDisclosure;
        });
    });
</script>

<script>
    function toggleOtherInput(selectId, inputId) {
        const select = document.getElementById(selectId);
        const input = document.getElementById(inputId);

        if (!select || !input) return;

        if (select.value === "99") {
            input.disabled = false;
        } else {
            input.disabled = true;
            input.value = "";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const primarySelect = document.getElementById("recipientSelect");
        

        if (primarySelect) {
            primarySelect.addEventListener("change", () =>
                toggleOtherInput("recipientSelect", "recipientOther")
            );
            toggleOtherInput("recipientSelect", "recipientOther");
        }

    });
</script>

