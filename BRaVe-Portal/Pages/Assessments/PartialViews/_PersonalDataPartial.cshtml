@model IEnumerable<Models.ViewModels.DataProcessingPersonalData>

@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs


@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.PersonalDataCategories ?? new List<LookupItemDto>();

    bool IsReadOnly = ViewData["IsReadOnly"] != null && (bool)ViewData["IsReadOnly"];

}

@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "PersonalData")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "PersonalData")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Category</th>
            <th>Special Category</th>
            <th>Purpose of Collection</th>
            <th style="width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.Count() == 0)
        {
            <tr class="alert alert-warning text-center mt-5 p-4 rounded shadow-sm">
                <td colspan="5">
                    No personal data categories available.
                </td>
            </tr>
        }
        else
            @foreach (var c in Model)
            {
                <tr>
                    <td> @LookupHelper.GetTextById(lookups, @c.PersonalDataCategoryId)</td>
                    <td>
                        @if (c.IsSpecialCategory)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times text-danger"></i>
                        }
                    </td>
                    <td>@c.PurposeOfDataCollection</td>
                    <td>
                        


                        @if (!IsReadOnly)
                        {

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editPersonalDataModal"
                                    data-PersonalDataAssessment="@c.AssessmentId"
                                    data-personal-id="@c.PersonalDataCategoryId"
                                    data-category="@c.IsSpecialCategory"
                                    data-purpose="@c.PurposeOfDataCollection">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                    data-id="@c.PersonalDataCategoryId"
                                    data-assessment-id="@c.AssessmentId"
                                    data-name="@LookupHelper.GetTextById(lookups, @c.PersonalDataCategoryId)"
                                    data-bs-toggle="modal" data-bs-target="#DeleteModal" data-handler="DeletePersonalData"
                                    data-entity="data">
                                <i class="fa fa-trash"></i>
                            </button>


                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">View-only</span>
                            <i class="fa-solid fa-lock ms-2 text-muted" data-bs-toggle="tooltip" title="Read-only: no actions"></i>

                        }
                    </td>
                </tr>
            }

    </tbody>
</table>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        var editModal = document.getElementById("editPersonalDataModal");

        editModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;

            // Get values from button attributes
            var assessmentId = button.getAttribute("data-PersonalDataAssessment");
            var personalId = button.getAttribute("data-personal-id");

            var category = "True"==button.getAttribute("data-category");

            //var category = button.getAttribute("data-category");
            var purpose = button.getAttribute("data-purpose");
            

            // Fill modal form
            document.getElementById("editPersonalDataAssessmentId").value = assessmentId;
            document.getElementById("editpersonalId").value = personalId;
            document.getElementById("editSelectPersonalId").value = personalId;
            document.getElementById("editCategory").checked = category;
            document.getElementById("editPurpose").value = purpose;
           
        });
    });
</script>

