@model IEnumerable<Models.ViewModels.DataProcessingDataSubject>

@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs

@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var hhtypes = coreLookups?.HouseholdTypes ?? new List<LookupItemDto>();

    bool IsReadOnly = ViewData["IsReadOnly"] != null && (bool)ViewData["IsReadOnly"];
}


@if (TempData["SuccessMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "DataSubject")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null && TempData["Section"] != null && TempData["Section"].ToString() == "DataSubject")
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Subject Type</th>
            <th>Vulnerable Group</th>
            <th style="width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>

        @if (Model.Count() == 0)
        {
            <tr class="alert alert-warning text-center mt-5 p-4 rounded shadow-sm">
                <td colspan="5">
                    No data subjects available.
                </td>
            </tr>
        }
        else
            @foreach (var c in Model)
            {
                <tr>
                    <td> @LookupHelper.GetTextById(hhtypes, @c.SubjectTypeId)</td>
                    <td>
                        @if (c.IsVulnerableGroup)
                        {
                            <i class="fa fa-check text-success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times text-danger"></i>         
                        }
                    </td>
                    <td>

                        @if (!IsReadOnly)
                        {

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editDataSubjectModal"
                                    data-DataSubjectAssessment="@c.AssessmentId"
                                    data-SubjectTypeId="@c.SubjectTypeId"
                                    data-DataSubjectIsVulnerableGroup="@c.IsVulnerableGroup">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger delete-button"
                                    data-id="@c.SubjectTypeId"
                                    data-assessment-id="@c.AssessmentId"
                                    data-name="@LookupHelper.GetTextById(hhtypes, @c.SubjectTypeId)"
                                    data-bs-toggle="modal" data-bs-target="#DeleteModal" data-handler="DeleteDataSubject"
                                    data-entity="data subject">
                                <i class="fa fa-trash"></i>
                            </button>


                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">View-only</span>
                            <i class="fa-solid fa-lock ms-2 text-muted" data-bs-toggle="tooltip" title="Read-only: no actions"></i>

                        }
                    </td>
                </tr>
            }

    </tbody>
</table>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var editModal = document.getElementById("editDataSubjectModal");

        editModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;

            // Get values from button attributes
            var assessmentId = button.getAttribute("data-DataSubjectAssessment");
            var SubjectTypeId = button.getAttribute("data-SubjectTypeId");

            var IsVulnerableGroup = "True"==button.getAttribute("data-DataSubjectIsVulnerableGroup");

            // Fill modal form
            document.getElementById("editDataSubjectAssessmentId").value = assessmentId;
            document.getElementById("editSubjectTypeId").value = SubjectTypeId;
            document.getElementById("editSelectSubjectTypeId").value = SubjectTypeId;
            document.getElementById("editDataSubjectIsVulnerableGroup").checked =  IsVulnerableGroup;
    
            debugger;

        });
    });
</script>

