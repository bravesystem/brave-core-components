@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@using BRaVe_Portal.Models.ViewModels
@model IEnumerable<UserNote>


@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.Roles ?? new List<LookupItemDto>();

    var notes = (Model ?? Enumerable.Empty<UserNote>())
                    .OrderByDescending(x => x.CreatedOn);
}


<details>
    <summary class="mb-2">
        <strong>Notes History</strong> (@notes.Count())
    </summary>

    <table class="table table-hover table-sm mb-0 align-middle mt-2">
        <thead class="table-light">
            <tr>
                <th style="width:120px">#</th>
                <th>Note</th>
                <th>Decision</th>
                <th style="width:140px">Role</th>
                <th style="width:200px">Created On</th>
            </tr>
        </thead>
        <tbody>
            @if (!notes.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No notes yet.</td></tr>
            }
            else
            {
                int i = 0;

                foreach (var n in notes)
                {
                    i++;

                    <tr>
                        <td>@i</td>
                        <td>@Html.Raw(Html.Encode(n.Note ?? "").Replace("\n", "<br/>"))</td>
                        <td>@n.Decision</td>
                        <td>
                            <span class="badge bg-secondary">

                                @if(n.CreatedByRole==(int)EnumUserRoles.RO)
                                {
                                    @LookupHelper.GetTextById(lookups, (int)EnumUserRoles.RO)
                                    @: /
                                    @LookupHelper.GetTextById(lookups, (int)EnumUserRoles.HQ)
                                }
                                else
                                {
                                    @LookupHelper.GetTextById(lookups, n.CreatedByRole)
                                }

                            </span>
                        </td>
                        <td>@n.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</details>
