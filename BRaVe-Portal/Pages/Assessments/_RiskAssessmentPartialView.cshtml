<partial name="Modals/Add Modals/_AddDisclosureRecipientModal" model="new DataProcessingDataDisclosureRecipient(){ AssessmentId= Model.AssessmentId}" />
<partial name="Modals/Add Modals/_AddSharingRecipientModal" model="new DataProcessingDataSharingRecipient(){ AssessmentId= Model.AssessmentId}" />
<partial name="Modals/Add Modals/_AddSecurityMeasureModal" model="new DataProcessingSecurityMeasure(){ AssessmentId= Model.AssessmentId}" />
<partial name="Modals/Add Modals/_AddDataOutputModal" model="new DataProcessingDataOutput(){ AssessmentId= Model.AssessmentId}" />
<partial name="Modals/Add Modals/_AddSourceOfDataModal" model="new DataProcessingSourceOfData(){ AssessmentId= Model.AssessmentId}" />

<!--Delete-->
 <partial name="Modals/_ConfirmDeleteModal" />

 <!--Edit-->
 <partial name="Modals/Edit Modals/_EditCollaboratorModal" model="new DataProcessingCollaborator()" />
 <partial name="Modals/Edit Modals/_EditPersonalDataModal" model="new DataProcessingPersonalData()" />
 <partial name="Modals/Edit Modals/_EditDisclosureRecipientModal" model="new DataProcessingDataDisclosureRecipient()" />
<partial name="Modals/Edit Modals/_EditSharingRecipientModal" model="new DataProcessingDataSharingRecipient()" />
<partial name="Modals/Edit Modals/_EditSecurityMeasureModal" model="new DataProcessingSecurityMeasure()" />
<partial name="Modals/Edit Modals/_EditDataOutputModal" model="new DataProcessingDataOutput()" />
<partial name="Modals/Edit Modals/_EditSourceOfDataModal" model="new DataProcessingSourceOfData()" />
<partial name="Modals/Edit Modals/_EditDataSubjectModal" model="new DataProcessingDataSubject()" />




<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById('delete-form');

  document.querySelectorAll('.delete-button').forEach(btn => {
    btn.addEventListener('click', () => {

      document.getElementById('delete-id').value = btn.dataset.id;
      document.getElementById('delete-assessment-id').value = btn.dataset.assessmentId;
      document.getElementById('delete-name').textContent = btn.dataset.name;
      document.getElementById('delete-entity').textContent = btn.dataset.entity;

 
      const url = new URL(window.location.href);

      // set (or replace) handler query param
      url.searchParams.set('handler', btn.dataset.handler);
      form.action = url.pathname + url.search;
    });
  });
});
</script>


<!--Javascript to shoe download links on lawful basis-->
<script>
document.addEventListener("DOMContentLoaded", function () {
    var modal = document.getElementById("saveSectionEModal");
    if (!modal) return;

    modal.addEventListener("show.bs.modal", function (event) {
        var button = event.relatedTarget;
        if (!button) return;

        toggleLink(
            button.getAttribute("data-lawfulbasis-path"),
            "lawfulBasisDownloadLink"
        );

        toggleLink(
            button.getAttribute("data-initialcollection-path"),
            "initialCollectionDownloadLink"
        );

        toggleLink(
            button.getAttribute("data-ongoing-path"),
            "ongoingDownloadLink"
        );

        toggleLink(
            button.getAttribute("data-datasharing-path"),
            "dataSharingDownloadLink"
        );
    });

    function toggleLink(path, linkId) {
        var link = document.getElementById(linkId);
        if (!link) return;

        if (path && path.trim() !== "") {
            link.classList.remove("d-none");
            link.href = `?handler=DownloadAttachment&blobPath=${encodeURIComponent(path)}`;
        } else {
            link.classList.add("d-none");
            link.removeAttribute("href");
        }
    }
});
</script>





