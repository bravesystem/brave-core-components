<form method="post" class="m-0">
    <input asp-for="AssessmentId" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Decision</label>
        <select asp-for="Decision" class="form-select">
            <option value="">Please select a decision</option>
            @foreach (var c in lookups)
            {
                <option value="@c.Id">@c.Text</option>

            }
        </select>

    </div>

    <div class="mb-3">
        <label class="form-label">Add Note</label>
        <textarea asp-for="Note" class="form-control"></textarea>
    </div>

    <div class="text-end mt-4">
        <button type="submit" asp-page-handler="SaveDecision" class="btn btn-success btn-lg">
            <i class="fa fa-save"></i> Save
        </button>

        @if (Model.IsValid)
        {
            <button type="submit" asp-page-handler="SubmitDecision" class="btn btn-info btn-lg">
                <i class="fa fa-save"></i> Submit
            </button>
        }
    </div>
</form>