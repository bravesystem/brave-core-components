@page "{assessmentId}"
@using BRaVe_Portal.Models.ViewModels
@model BRaVe_Portal.Pages.Assessment.CreateAssessmentModel

@{
    ViewData["Title"] = "Risk-Benefit Assessment";
}

<div class="d-flex align-items-center mb-4">
    <!-- Back Button on Top Left -->
    <a href="javascript:history.back()" data-no-loader class="btn btn-outline-secondary me-auto">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>

    <!-- Centered Title -->
    <h5 class="fw-bold text-primary text-center flex-grow-1">
        <i class="fa-solid fa-clipboard-check"></i> Registration & Risk-Benefit Assessment Form
    </h5>

    <!-- Spacer to balance the flexbox (keeps title centered) -->
    <div style="width:70px;"></div>
</div>

<partial name="_RiskAssessmentPartialView" model="Model.Assessment" />

<div class="text-end mt-4">
    <form method="post" asp-page-handler="SaveAssessment">

        @Html.AntiForgeryToken()

        <input asp-for="@Model.AssessmentId" type="hidden" />
        <button type="submit" class="btn btn-success btn-lg">
            <i class="fa fa-save"></i> Save
        </button>
    </form>
</div>