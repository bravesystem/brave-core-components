@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Models.ViewModels.DataProcessingSecurityMeasure


@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.SecurityMeasures ?? new List<LookupItemDto>();
}


<div class="modal fade" id="editSecurityMeasureModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Security Measure</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" required></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="EditSecurityMeasure">
                    <input type="hidden" asp-for="AssessmentId" id="editSecurityMeasureAssessmentId" />
                    <div class="mb-3">
                        <label class="form-label">Measure</label>
                        <select asp-for="SecurityMeasureId" class="form-select" id="editSecurityMeasureId">
                            @foreach (var c in lookups)
                            {
                                <option value="@c.Id">@c.Text</option>

                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Technical Measures</label>
                        <textarea asp-for="TechnicalMeasures" class="form-control" id="editTechnicalMeasures" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Organizational Measures</label>
                        <textarea asp-for="OrganizationalMeasures" class="form-control" id="editOrganizationalMeasures" required></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

