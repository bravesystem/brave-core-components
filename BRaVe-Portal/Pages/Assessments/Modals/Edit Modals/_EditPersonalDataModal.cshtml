@model BRaVe_Portal.Models.ViewModels.DataProcessingPersonalData


@using BRaVe_Portal.Helpers
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs

@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.PersonalDataCategories ?? new List<LookupItemDto>();
}



<div class="modal fade" id="editPersonalDataModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Personal Data</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">


                <form method="post" enctype="multipart/form-data" asp-page-handler="EditPersonalData">
                    <input type="hidden" asp-for="AssessmentId" id="editPersonalDataAssessmentId" />
                    <input type="hidden" asp-for="PersonalDataCategoryId" id="editpersonalId" />
                   

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select asp-for="PersonalDataCategoryId" class="form-select" id="editSelectPersonalId" disabled>
                            @foreach (var c in lookups)
                            {
                                <option value="@c.Id">@c.Text</option>

                            }
                        </select>


                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsSpecialCategory" class="form-check-input" type="checkbox" id="editCategory" />
                        <label class="form-check-label">Special Category?</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Purpose of Data Collection</label>
                        <textarea asp-for="PurposeOfDataCollection" class="form-control" id="editPurpose"></textarea>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


