@page "{assessmentId:int}/{statusId}"
@model BRaVe_Portal.Pages.Assessments.LegalUpdateAssessmentModel
@{
    ViewData["Title"] = "Risk-Benefit Assessment";
}



<div class="d-flex align-items-center mb-4">
    <!-- Back Button on Top Left -->
    <a href="javascript:history.back()" class="btn btn-outline-secondary me-auto">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>

    <!-- Centered Title -->
    <h5 class="fw-bold text-primary text-center flex-grow-1">
        <i class="fa-solid fa-clipboard-check"></i> View Registration & Risk-Benefit Assessment, Status: Legal - Review in Progress
    </h5>

    <!-- Spacer to balance the flexbox (keeps title centered) -->
    <div style="width:70px;"></div>
</div>

<partial name="_RiskAssessmentPartialView" model="Model.Assessment" />

@if (TempData["SaveRecommendation"] != null)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

}

