<form method="post" class="m-0">
    <input asp-for="AssessmentId" type="hidden" />


    <div class="mb-3">
        <label class="form-label">Add Recommendation</label>
        <textarea asp-for="Note" class="form-control"></textarea>
    </div>

    <div class="text-end mt-4">
        <button type="submit" asp-page-handler="SaveRecommendation" class="btn btn-success btn-lg">
            <i class="fa fa-save"></i> Save
        </button>

        @if (Model.IsValid)
        {
            <button type="submit" asp-page-handler="SubmitRecommendation" class="btn btn-info btn-lg">
                <i class="fa fa-save"></i> Submit
            </button>
        }
    </div>
</form>