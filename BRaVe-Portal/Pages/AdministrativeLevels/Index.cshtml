@page
@model BRaVe_Portal.Pages.AdministrativeLevels.IndexModel
@{
    ViewData["Title"] = "Administrative Levels Management";
    Layout = "_SectionMenu";
}


@section SubMenuBar {
    <div class="page-tabs">
        <a asp-page="/AdministrativeLevels/Index" class="tab-item active">Administrative Levels</a>
        <a asp-page="/Locations/Index" class="tab-item">Administrative Areas</a>

    </div>

}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white fw-bold">ALL Administrative Levels</div>

    <div class="card-body p-3">
        <div class="mb-3 text-end">
            <button type"button"
                    class="btn btn-success btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addAdministrativeLevelModal">
                <i class="fa fa-plus"></i> Add  Administrative Level

            </button>

@*             <button class="btn btn-sm rounded-pill d-flex align-items-center shadow-sm fw-semibold upload-btn"
                    style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-toggle="modal" data-bs-target="#UploadExcelAdministrativeLevelsModal">
                <i class="fa-solid fa-file-upload me-2"></i> Upload Administrative Level Excel
            </button>
 *@
          
        </div>
        <!-- Search input -->
        <div class="mb-3 d-flex justify-content-center">
            <div class="position-relative" style="max-width: 500px; width: 100%;">
                <input id="searchInput" type="text"
                       class="form-control shadow-sm rounded-pill ps-5 pe-4"
                       placeholder="Search admin levels..."
                       value="@Model.SearchTerm" />
                <span class="position-absolute top-50 start-0 translate-middle-y ps-3">
                    <i class="bi bi-search" style="color:#004080;"></i>
                </span>
            </div>
        </div>

        <!-- Page size + pagination -->
        <div class="d-flex justify-content-between align-items-center mb-2 p-3 small">
            <form method="get" class="d-inline-flex align-items-center mb-0">
                <span>Show</span>
                <select asp-for="PageSize" class="form-select form-select-sm"
                        style="width:auto;display:inline-block;margin:0 4px;"
                        onchange="this.form.submit()">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>
                <input type="hidden" asp-for="SearchTerm" />
                <input type="hidden" asp-for="CurrentPage" />
            </form>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage - 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?CurrentPage=@i&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage + 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Next</a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Users Table -->

        <table class="table table-bordered table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Type</th>
                     <th>Is Active</th>
                    <th>Last Updated</th>
                    <th style="width:200px;">Edit</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FilteredUsers.Any())
                {
                    foreach (var administrativeLevel in Model.FilteredUsers)

                    {
                        <tr>
                            <td>@administrativeLevel.Id</td>
                            <td>@administrativeLevel.LevelName</td>
                            <td>@administrativeLevel.OfficialCode</td>
                            <td class="text-center align-middle">
                            @if (administrativeLevel.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="fa fa-check"></i>
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fa fa-times"></i>
                                </span>
                            }
                            </td>
                            <td>@administrativeLevel.UpdatedOn</td>

                            <td>

                                <button type="button" 
                                        class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#EditAdministrativeLevelModal"
                                        data-id="@administrativeLevel.Id"
                                        data-OfficialCode="@administrativeLevel.OfficialCode"
                                        data-LevelName="@administrativeLevel.LevelName"
                                        data-Active="@administrativeLevel.IsActive">
                                    <i class="fa fa-edit"></i> Edit
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No Administrative Levels  found</td>
                    </tr>
                }
            </tbody>
        </table>


    
    </div>
</div>
<partial name="UploadExcelAdministrativeLevelsModal" />
@section Scripts {
    <partial name="_EditAdministrativeLevelModal" model="@Model.UpdatedAdministrativeLevel" />

    <partial name="_AddAdministrativeLevelModal" model="@Model.AdministrativeLevel" />
    <script>
  

        const searchInput = document.getElementById("searchInput");
        let debounceTimer;

        searchInput.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                const searchTerm = encodeURIComponent(searchInput.value);
                const pageSize = @Model.PageSize;
                const currentPage = 1; // reset to first page on new search
                const url = `?SearchTerm=${searchTerm}&PageSize=${pageSize}&CurrentPage=${currentPage}`;

                fetch(url)
                    .then(resp => resp.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");

                        // Replace table
                        const newTable = doc.querySelector("#usersTable").outerHTML;
                        document.querySelector("#usersTable").outerHTML = newTable;

                        // Replace pagination
                        const newPagination = doc.querySelector(".pagination").outerHTML;
                        document.querySelector(".pagination").outerHTML = newPagination;
                    });
            }, 400);
        });
    </script>
    <script>
        var editModal = document.getElementById('EditAdministrativeLevelModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Button that triggered the modal


            var Id = button.getAttribute('data-Id');
                  var LevelName = button.getAttribute('data-LevelName');
            var OfficialCode = button.getAttribute('data-OfficialCode');

                 var UpdatedOn = button.getAttribute('data-UpdatedOn');
                var active = button.getAttribute('data-active') === 'True';

            // Fill form fields inside modal
              document.getElementById('editId').value = Id;
            document.getElementById('editLevelName').value = LevelName;
            document.getElementById('editOfficialCode').value = OfficialCode;
                        document.getElementById('editactive').checked = active;

            document.getElementById('editUpdatedOn').value = UpdatedOn;
        });
    </script>
}


