@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model AdministrativeLevel



<div class="modal fade" id="EditAdministrativeLevelModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Administrative Level</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="EditAdministrativeLevel">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" id="editId" />

                    <div class="mb-3">
                        <label class="form-label">Name </label>
                        <input asp-for="LevelName" class="form-control" id="editLevelName" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <input asp-for="OfficialCode" class="form-control" id="editOfficialCode" >
                    </div>


                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" id="editactive" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>