@page
@model BRaVe_Portal.Pages.Locations.IndexModel
@using BRaVe_Portal.Models
@using BRaVe_Portal.Helpers


 @{
    ViewData["Title"] = "Administrative Area Management ";
    Layout = "_SectionMenu";
}


@section SubMenuBar {
    <div class="page-tabs">
        <a asp-page="/AdministrativeLevels/Index" class="tab-item">Administrative Levels</a>
        <a asp-page="/Locations/Index" class="tab-item active">Administrative Areas</a>

    </div>

}

 

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white fw-bold px-3 py-2 d-flex justify-content-between align-items-center">
        <span>Administrative Area</span>
       


        <button class="btn btn-sm rounded-pill d-flex align-items-center shadow-sm fw-semibold upload-btn"
                style="background-color: #ffc107; color: #212529; border: 1px solid #ffc107;" data-bs-toggle="modal" data-bs-target="#UploadExcelAdministrativeLevelLocationModal">
            <i class="fa-solid fa-file-upload me-2"></i> Upload Administrative  Areas Excel
        </button>
    </div>

    <div class="p-3">

     
        <div class="d-flex align-items-center justify-content-between mb-3">

            <!-- Search -->
            <form method="get" class="mb-0 flex-grow-1 d-flex justify-content-center">
                <div class="position-relative" style="max-width: 500px; width: 100%;">
                    <input type="text"
                           id="searchInput"
                           name="SearchTerm"
                           value="@Model.DisplaySearchTerm"
                           class="form-control shadow-sm rounded-pill ps-5 pe-4"
                           placeholder="Search Administrative Area..." />

                    <span class="position-absolute top-50 start-0 translate-middle-y ps-3">
                        <i id="searchIcon" class="fa fa-search text-primary"></i>
                    </span>
                </div>
            </form>


            <!-- Add Button  -->
            <button type="button"
                    class="btn btn-success shadow-sm rounded-pill px-4 ms-3 d-flex align-items-center"
                    style="height: 38px;"
                    data-bs-toggle="modal"
                    data-bs-target="#addAdminLevelLocationModal">
                <i class="fa fa-plus me-2"></i> Add Administrative Area
            </button>

        </div>


        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-striped table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Admin Level</th>
                        <th>Administrative Area</th>
                                                <th>P-Code</th>
                        <th>Parent Administrative Area</th>
                        <th>Active</th>
                        <th> last update date</th>
                        <th style="width:200px;">Edit</th>
                    </tr>
                </thead>

                <tbody id="locationsTbody">
                    @if (Model.Locations != null)
                    {
                        @foreach (var location in Model.Locations.OrderByDescending(l => l.UpdatedOn).Select((q, index) => new { q, index }))
                        {
                            <tr>
                                <td>@location.q.LevelId</td>
                                <td>@location.q.LocationName</td>
                                <td>@location.q.OfficialCode</td>
                                <td>@location.q.ParentLocationName</td>
                                <td>
                                    @if (location.q.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa fa-check"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fa fa-times"></i>
                                        </span>
                                    }
                                </td>

                                <td>@location.q.UpdatedOn</td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#EditLocationModal2"
                                            data-id="@location.q.Id"
                                            data-name="@location.q.LocationName"
                                            data-code="@location.q.OfficialCode"
                                            data-level="@location.q.LevelId"
                                            data-parent="@location.q.ParentLocationId"
                                            data-active="@location.q.IsActive">
                                        <i class="fa fa-edit"></i> Edit
                                    </button>


                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted p-4">
                                No Administrative Area found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="mt-4 text-center">


                <a asp-page-handler="DownloadExcelAdministrativeLevelLocation"  class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="fa-solid fa-file-circle-plus me-1"></i> Download Excel Template 
                </a>
            </div>

        </div>
    </div>
</div>



<!-- Delete Modal -->
<div class="modal fade" id="deleteDataPointModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-3 border-0">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fa fa-exclamation-triangle me-2"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <strong>Are you sure you want to delete this Parent Administrative Area?</strong>
            </div>

            <div class="modal-footer">
                <form method="post" asp-page-handler="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DataPointId" id="delete-id" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>

            </div>

        </div>
    </div>
</div>

<!-- Pagination -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 p-3 bg-light rounded shadow-sm small">

    <form method="get" class="d-inline-flex align-items-center mb-0">
       
        <span class="me-2 text-muted">Show</span>
        <select class="form-select form-select-sm me-2"
                name="PageSize"
                style="width: auto;"
                onchange="this.form.submit()">
            <option value="5" selected="@(Model.PageSize == 5)">5</option>
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="25" selected="@(Model.PageSize == 25)">25</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
        </select>
        <span class="text-muted">entries</span>
    </form>

    <nav aria-label="datapoint pagination">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-SearchTerm="@Model.DisplaySearchTerm">
                    <i class="fa fa-chevron-left me-1"></i> Prev
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SearchTerm="@Model.DisplaySearchTerm">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-SearchTerm="@Model.DisplaySearchTerm">
                    Next <i class="fa fa-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>

</div>

<partial name="UploadExcelAdministrativeLevelLocationModal" />
<partial name="_AddLocationModal" model="Model" />
<partial name="_EditLocationModal" model="Model" />

@section Scripts {
    <script>
        async function loadParents(levelSelectId, sectionId, dropdownId) {
            const levelSelect = document.getElementById(levelSelectId);
            const section = document.getElementById(sectionId);
            const dropdown = document.getElementById(dropdownId);

            levelSelect.addEventListener('change', async () => {
                const levelId = parseInt(levelSelect.value);
                dropdown.innerHTML = '<option value="">-- Select Parent --</option>';

                if (!levelId || levelId <= 1) {
                    section.classList.add('d-none');
                    return;
                }

                section.classList.remove('d-none');

                const res = await fetch(`?handler=ParentLocations&levelId=${levelId - 1}`);
                const data = await res.json();

                data.forEach(p => {
                    dropdown.insertAdjacentHTML(
                        'beforeend',
                        `<option value="${p.id}">${p.locationName}</option>`
                    );
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadParents('adminLevelAdd', 'parentSectionAdd', 'parentLocationAdd');
            loadParents('adminLevelEdit', 'parentSectionEdit', 'parentLocationEdit');
        });
    </script>

<script>
const searchInput = document.getElementById('searchInput');
const tbody = document.getElementById('locationsTbody');
const searchIcon = document.getElementById('searchIcon');

let debounceTimer;

searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);

    debounceTimer = setTimeout(async () => {
        const term = searchInput.value.trim();

        searchIcon.className = 'fa fa-spinner fa-spin text-primary';

        const res = await fetch(`?SearchTerm=${encodeURIComponent(term)}`);
        const html = await res.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newTbody = doc.getElementById('locationsTbody');

        if (newTbody) {
            tbody.innerHTML = newTbody.innerHTML;
        }

        searchIcon.className = 'fa fa-search text-primary';
    }, 400);
});
</script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const editModal = document.getElementById('EditLocationModal2');

            editModal.addEventListener('show.bs.modal', async function (event) {

                const button = event.relatedTarget;

                const id = button.getAttribute('data-id');
                const name = button.getAttribute('data-name');
                const code = button.getAttribute('data-code');
                const levelId = button.getAttribute('data-level');
                const parentId = button.getAttribute('data-parent');
                const isActive = button.getAttribute('data-active') === 'True';

                // Fill fields
                document.querySelector('[name="UpdatedLocation.Id"]').value = id;
                document.querySelector('[name="UpdatedLocation.LocationName"]').value = name;
                document.querySelector('[name="UpdatedLocation.OfficialCode"]').value = code;
                document.querySelector('[name="UpdatedLocation.LevelId"]').value = levelId;
                document.querySelector('[name="UpdatedLocation.IsActive"]').checked = isActive;

                const parentSection = document.getElementById('parentSectionEdit');
                const parentDropdown = document.getElementById('parentLocationEdit');

                parentDropdown.innerHTML = '<option value="">-- Select Parent --</option>';

                // Hide parent if level <= 1
                if (!levelId || levelId <= 1) {
                    parentSection.classList.add('d-none');
                    return;
                }

                parentSection.classList.remove('d-none');

                // Load parents (same logic as Add)
                const res = await fetch(`?handler=ParentLocations&levelId=${levelId - 1}`);
                const data = await res.json();

                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.locationName;

                    if (parentId && p.id.toString() === parentId) {
                        opt.selected = true;
                    }

                    parentDropdown.appendChild(opt);
                });
            });

        });
    </script>

}




