@page "{ConsentId:int}/{ProgramId:int}"

@model BRaVe_Portal.Pages.Consents.ManageConsentTranslationsModel

@{
    ViewData["Title"] = "Manage Consent Translations";
}
<a asp-page="/Consents/Index"
   asp-route-SelectedProgramId="@Model.ProgramId"
   class="btn btn-outline-primary d-inline-flex align-items-center">
    <i class="fa fa-arrow-left me-2"></i> Back
</a>

<br />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h4 class="fw-bold mb-0">
                Consent: @Model.ConsentId - Program: @Model.ProgramId
            </h4>

            <br />

            <p class="text-muted small mb-0">

                Default Language:
                <span class="badge bg-primary">
                    @Model.DefaultLang
                </span>

                <br />

            </p>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">

            <span>Translations</span>

            <button type="button"
                    class="btn btn-light btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addTranslationModal">

                <i class="fa fa-plus"></i> Add Translation

            </button>

        </div>

        <div class="card-body p-0">

            <table class="table table-striped table-bordered mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Default</th>
                        <th>Language</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var t in Model.Translations)
                    {
                        <tr>

                            <td class="text-center">

                                <input class="form-check-input"
                                       type="checkbox"
                                       disabled
                                       @(t.LanguageCode == Model.DefaultLang ? "checked" : "") />

                            </td>

                            <td>@t.LanguageCode</td>

                            <td>@t.Text</td>

                            <td>@t.Description</td>

                            <td class="text-center">

                                <div class="d-inline-flex gap-2">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTranslationModal"
                                            data-id="@Model.ConsentId"
                                            data-language="@t.LanguageCode"
                                            data-text="@t.Text"
                                            data-description="@t.Description"
                                            title="Edit Translation">

                                        <i class="fa fa-edit"></i>

                                    </button>

                                    @if (t.LanguageCode != Model.DefaultLang)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteTranslationModal"
                                                data-language="@t.LanguageCode"
                                                title="Delete Translation">

                                            <i class="fa fa-trash"></i>

                                        </button>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <br />

</div>


<!-- =====================================================
     ADD TRANSLATION MODAL
===================================================== -->

<div class="modal fade"
     id="addTranslationModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add Translation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form method="post"
                      asp-page-handler="AddTranslation">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="NewTranslation.ConsentId"
                           value="@Model.ConsentId" />

                    <input type="hidden"
                           asp-for="NewTranslation.ProgramId"
                           value="@Model.ProgramId" />

                    <div class="mb-3">

                        <label class="form-label">
                            Language Code
                        </label>

                        <select class="form-select"
                                asp-for="NewTranslation.LanguageCode"
                                required>

                            <option value="en">en</option>
                            <option value="fr">fr</option>
                            <option value="es">es</option>
                            <option value="sw">sw</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Title
                        </label>

                        <input asp-for="NewTranslation.Text"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea asp-for="NewTranslation.Description"
                                  class="form-control"
                                  rows="5"></textarea>

                    </div>

                    <div class="text-end">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa fa-save"></i> Save

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     EDIT TRANSLATION MODAL
===================================================== -->

<div class="modal fade"
     id="editTranslationModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Edit Translation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form method="post"
                      asp-page-handler="EditTranslation">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="EditTranslation.ConsentId"
                           value="@Model.ConsentId" />

                    <input type="hidden"
                           asp-for="EditTranslation.ProgramId"
                           value="@Model.ProgramId" />

                    <div class="mb-3">

                        <label class="form-label">
                            Language Code
                        </label>

                        <input asp-for="EditTranslation.LanguageCode"
                               id="editLanguageCode"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Title
                        </label>

                        <input asp-for="EditTranslation.Text"
                               id="editText"
                               class="form-control"
                               required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea asp-for="EditTranslation.Description"
                                  id="editDescription"
                                  class="form-control"
                                  rows="5"></textarea>

                    </div>

                    <div class="text-end">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fa fa-save"></i> Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     DELETE MODAL
===================================================== -->

<div class="modal fade"
     id="deleteTranslationModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content shadow-lg rounded-3 border-0">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    <i class="fa fa-exclamation-triangle me-2"></i>
                    Confirm Delete

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <strong>
                    Are you sure you want to delete this translation?
                </strong>

            </div>

            <div class="modal-footer">

                <form method="post"
                      asp-page-handler="DeleteTranslation">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="languageCode"
                           id="deleteLanguageCode" />

                    <input type="hidden"
                           name="ConsentId"
                           value="@Model.ConsentId" />

                    <input type="hidden"
                           name="ProgramId"
                           value="@Model.ProgramId" />

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="fa fa-trash"></i> Yes, Delete

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        /* =====================================================
           EDIT MODAL
        ===================================================== */

        const editModal =
            document.getElementById('editTranslationModal');

        editModal.addEventListener(
            'show.bs.modal',
            function (event) {

                const button = event.relatedTarget;

                const language =
                    button.getAttribute('data-language');

                const text =
                    button.getAttribute('data-text');

                const description =
                    button.getAttribute('data-description');

                document.getElementById(
                    'editLanguageCode'
                ).value = language;

                document.getElementById(
                    'editText'
                ).value = text;

                document.getElementById(
                    'editDescription'
                ).value = description;
            });


        /* =====================================================
           DELETE MODAL
        ===================================================== */

        const deleteModal =
            document.getElementById('deleteTranslationModal');

        deleteModal?.addEventListener(
            'show.bs.modal',
            function (event) {

                const button = event.relatedTarget;

                const language =
                    button.getAttribute('data-language');

                document.getElementById(
                    'deleteLanguageCode'
                ).value = language;

            });

    </script>
}