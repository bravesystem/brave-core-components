@using BRaVe_Portal.Models.DTOs
@model ConsentDto



<div class="modal fade" id="addConsentModal" tabindex="-1" aria-labelledby="addConsentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Consent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" asp-page-handler="AddConsent">
                    @Html.AntiForgeryToken()
                    <input asp-for="ProgramId" type="hidden" />

 
                    <div class="mb-3">
                        <label class="form-label">Title: </label>
                        <input asp-for="Title" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Consent Text:</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                      @*   <input asp-for="Description" class="form-control"> *@
                    </div>


                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>