@page
@model BRaVe_Portal.Pages.LoginModel
@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BRaVe Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #004080;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-container {
            background: #fff;
            color: #333;
            padding: 3rem;
            border-radius: 1.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
            max-width: 420px;
            width: 100%;
            position: relative;
        }

        .env-box-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 7px;
            border-radius: 8px;
            letter-spacing: 0.4px;
        }

        .dev-badge {
            background-color: #ffc107;
            color: #000;
        }

        .uat-badge {
            background-color: #0d6efd;
            color: #fff;
        }

        .partner-badge {
            background-color: #6f42c1;
            color: #fff;
        }

        .login-container h1 {
            margin-bottom: 1rem;
            font-size: 2rem;
            color: #004b87;
        }

        .login-container p {
            margin-bottom: 2rem;
            color: #555;
        }

        .login-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 0.8rem;
            margin-bottom: 1rem;
            border: none;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease, background 0.3s ease;
            text-decoration: none;
            box-sizing: border-box;
        }

            .login-btn i {
                margin-right: 0.5rem;
            }

            .login-btn.azure-ad {
                background: #0056B3;
                color: #fff;
            }

                .login-btn.azure-ad:hover {
                    background: #0056B3;
                    transform: scale(1.05);
                }

            .login-btn.azure-b2c {
                background: #E0A800;
                color: #fff;
            }

                .login-btn.azure-b2c:hover {
                    background: #E0A800;
                    transform: scale(1.05);
                }

        .login-notice {
            background: #fff3cd;
            color: #664d03;
            border: 1px solid #ffecb5;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            text-align: left;
            line-height: 1.4;
        }
    </style>
</head>
<body>
    <div class="login-container">
        @if (Model.AppEnvironment == "DEV" || Model.AppEnvironment == "UAT")
        {
            <span class="env-box-badge @(Model.AppEnvironment == "DEV" ? "dev-badge" : "uat-badge")">
                @Model.AppEnvironment ENVIRONMENT
            </span>
        }

        @if (Model.IsPartner)
        {
            <span class="env-box-badge partner-badge">PARTNER</span>
        }

        <img src="Images/iombrave_logo.png" alt="BRaVe Logo" style="max-width:300px; margin-bottom:1rem;" />
        <h1>Welcome to the BRaVe Management Portal</h1>
        <p>Please choose a login method to continue</p>

        <form method="get" action="/auth-login">
            <button type="submit" class="login-btn azure-ad">
                <i class="fa-solid fa-building"></i> @Model.PrimaryLoginButtonText
            </button>
        </form>

        @if (Model.AppEnvironment == "DEV" || Model.AppEnvironment == "UAT")
        {
            <a href="@Model.PartnerAccessUrl" class="login-btn azure-b2c">
                <i class="fa-solid fa-users"></i> Partner Test Login
            </a>
        }
        else if (Model.IsPartner)
        {
            <a href="@Model.PartnerAccessUrl" class="login-btn azure-b2c">
                <i class="fa-solid fa-users"></i> Form Login
            </a>
            <div class="login-notice" role="alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <strong>Temporary access:</strong> Form login is available until non-Microsoft provider sign-in to BRaVe is restored.
            </div>
        }
        else
        {
            <a href="https://iom-ptr-we-webapp-brave-002.azurewebsites.net/Login" class="login-btn azure-b2c">
                <i class="fa-solid fa-users"></i> Partner Portal
            </a>
        }
    </div>
</body>
</html>
