@page
@model BRaVe_Portal.Pages.requests.IndexModel
@{
    ViewData["Title"] = "Pending User Requests";
}
<style>
    /* Blue border + glow on focus */
    #searchInput:focus {
        border-color: #004080;
        box-shadow: 0 0 0 0.25rem rgba(0,64,128,0.25);
    }

    /* Search icon color */
    .search-icon {
        color: #004080;
    }

    /* Table enhancements */
    #requestsTable {
        border-radius: 0.5rem;
        overflow: hidden;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

        #requestsTable thead {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        #requestsTable tbody tr:hover {
            background-color: #e9f2ff;
        }

        #requestsTable td, #requestsTable th {
            vertical-align: middle;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
        }

    /* Dropdown enhancements */
    .form-select {
        min-width: 180px;
        padding: 0.45rem 0.75rem;
        font-weight: 500;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.08);
        transition: all 0.3s;
    }

        .form-select:focus {
            border-color: #004080;
            box-shadow: 0 0 0 0.25rem rgba(0,64,128,0.25);
            outline: none;
        }

    /* Assign button enhancement */
    .btn-assign {
        min-width: 120px;
        font-weight: 600;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.1);
        transition: all 0.2s;
    }

        .btn-assign:hover {
            transform: translateY(-2px);
        }
</style>


<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white fw-bold">
        Pending User Requests
    </div>
@if (Model.FilteredRequests.Any())
{
    <div class="card-body p-0">

        <!-- Dynamic Bootstrap Alerts Container -->
        <div id="dynamicAlertContainer" class="p-3"></div>

        <div class="p-3 d-flex justify-content-center">
            <div class="position-relative" style="max-width: 500px; width: 100%;">
                <form method="get" class="d-flex w-100">
                    <!-- Search Input -->
                    <input id="searchInput" type="text" name="SearchTerm" value="@Model.SearchTerm"
                           class="form-control shadow-sm rounded-pill ps-5 pe-4"
                           placeholder="Search pending users..."
                           style="height: 45px; font-size: 1rem; border: 1px solid #ddd; transition: all 0.3s;" />

                    <!-- Search Icon -->
                    <span class="position-absolute top-50 start-0 translate-middle-y ps-3">
                        <i class="bi bi-search search-icon"></i>
                    </span>
                </form>
            </div>
        </div>

        <!--Error notification-->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!--Success notification-->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Page size + pagination -->
        <div class="d-flex justify-content-between align-items-center mb-2 p-3 small">
            <form method="get" asp-page="/requests/Index" class="d-inline-flex align-items-center mb-0">
                <span>Show</span>
                <select asp-for="PageSize" class="form-select form-select-sm"
                        style="width:auto;display:inline-block;margin:0 4px;"
                        onchange="this.form.submit()">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>

                <input type="hidden" asp-for="SearchTerm" />
                <input type="hidden" asp-for="CurrentPage" />
            </form>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage - 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?CurrentPage=@i&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage + 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Next</a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- POST form (assignments) -->
        <form method="post" id="assignForm">
            <table class="table table-bordered table-hover align-middle mb-0" id="requestsTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:40px;">Select</th>
                        <th>User Email</th>
                        <th>Profile Name</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FilteredRequests.Any())
                    {
                        foreach (var user in Model.FilteredRequests)
                        {
                            <tr>
                                <td><input type="radio" name="SelectedUser" value="@user.Id" /></td>
                                <td>@user.UserDetails</td>
                                <td>@user.ProfileName</td>
                                <td>@user.Justification</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No matching requests found</td>
                        </tr>
                    }
                </tbody>
            </table><br />

            <!-- Assign Mission & Role Section -->
            <div class="p-3">
                <h6 class="text-secondary mb-3">Assign Mission & Role</h6>
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <div class="input-group shadow-sm">
                        <select asp-for="SelectedMissionId" asp-items="Model.Missions" class="form-select">
                            <option value="" disabled selected hidden>-- Select Mission --</option>
                        </select>
                    </div>

                    <div class="input-group shadow-sm">
                        <select asp-for="SelectedRoleId" asp-items="Model.Roles" class="form-select">
                            <option value="" disabled selected hidden>-- Select Role --</option>
                        </select>
                    </div>

                    <button type="button" class="btn btn-success shadow-sm btn-assign" onclick="showConfirmModal()">Assign</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">Confirm Assignment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Email:</strong> <span id="modalUserEmail"></span></p>
                    <p><strong>Mission:</strong> <span id="modalMission"></span></p>
                    <p><strong>Role:</strong> <span id="modalRole"></span></p>
                    <p>Are you sure you want to assign this mission and role to the user?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="confirmAssignBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    }
    else
    {

        <div class="alert alert-warning text-center mt-5 p-4 rounded shadow-sm">
            <h4 class="alert-heading">No Pending Requests found</h4>
        </div>


    }
</div>



@section Scripts {
    <script>
        function showBootstrapAlert(message, type = 'danger') {
            const container = document.getElementById('dynamicAlertContainer');
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            container.appendChild(alertDiv);
            setTimeout(() => {
                alertDiv.classList.remove('show');
                alertDiv.classList.add('hide');
                setTimeout(() => alertDiv.remove(), 300);
            }, 5000);
        }

        function showConfirmModal() {
            const selectedUserRadio = document.querySelector('input[name="SelectedUser"]:checked');
            const missionSelect = document.querySelector('select[name="SelectedMissionId"]');
            const roleSelect = document.querySelector('select[name="SelectedRoleId"]');

            if (!selectedUserRadio) {
                showBootstrapAlert('Please select a user.');
                return;
            }
            if (!missionSelect.value) {
                showBootstrapAlert('Please select a mission.');
                return;
            }
            if (!roleSelect.value) {
                showBootstrapAlert('Please select a role.');
                return;
            }

            const selectedRow = selectedUserRadio.closest('tr');
            document.getElementById('modalUserEmail').textContent = selectedRow.cells[1].textContent;
            document.getElementById('modalMission').textContent = missionSelect.options[missionSelect.selectedIndex].text;
            document.getElementById('modalRole').textContent = roleSelect.options[roleSelect.selectedIndex].text;

            const confirmModal = new bootstrap.Modal(document.getElementById('confirmModal'));
            confirmModal.show();

            document.getElementById('confirmAssignBtn').onclick = function () {
                selectedUserRadio.closest('form').submit();
            };
        }

        //AJAX code for a dynamic search button

             const searchInput = document.getElementById("searchInput");
        let debounceTimer;

        searchInput.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                fetch(`/requests/Index?SearchTerm=${encodeURIComponent(searchInput.value)}&PageSize=@Model.PageSize`)
                    .then(response => response.text())
                    .then(html => {
                        // Extract just the table from the response
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");
                        const newTable = doc.querySelector("#requestsTable").parentNode.innerHTML;

                        document.querySelector("#requestsTable").parentNode.innerHTML = newTable;
                    });
            }, 400);
        });
    </script>
}
