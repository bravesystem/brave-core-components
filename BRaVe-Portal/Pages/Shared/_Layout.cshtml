    <!--Hide alerts after 5 seconds-->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
          // Only select success and danger alerts
          var alerts = document.querySelectorAll('.alert.alert-success, .alert.alert-danger');

          alerts.forEach(function (alert) {
            // Auto dismiss after 8 seconds (8000 ms)
            setTimeout(function () {
              var bsAlert = new bootstrap.Alert(alert);
              bsAlert.close();
            }, 8000);
          });
        });
    </script>



    ;<!-- SCRIPT TO RECORD FORM POSTION BEFORE SUBMIT AND RETURN TO SAME POSTION-->


    <script>
        // Use a unique key for this exact page
        const pageKey = "scrollPosition_/Assessments/PMUpdateAssessment";

        // Save scroll before unload
        window.addEventListener("beforeunload", function () {
            localStorage.setItem(pageKey, window.scrollY);
        });

        // Restore scroll after load
        window.addEventListener("load", function () {
            const scrollPos = localStorage.getItem(pageKey);
            if (scrollPos) {
                window.scrollTo(0, parseInt(scrollPos, 10));
                localStorage.removeItem(pageKey); // remove if only needed once
            }
        });
    </script>




    <script>
        // Toggle sidebar
        document.getElementById("sidebarToggle").addEventListener("click", function () {
            document.getElementById("sidebarMenu").classList.toggle("collapsed");
            document.getElementById("topNav").classList.toggle("collapsed");
            document.getElementById("mainContent").classList.toggle("collapsed");
            document.getElementById("footer").classList.toggle("collapsed");
        });

        // Keep clicked menu item active
        const navLinks = document.querySelectorAll("#sidebarNav .nav-link");
        navLinks.forEach(link => {
            link.addEventListener("click", function () {
                navLinks.forEach(l => l.classList.remove("active"));
                this.classList.add("active");
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.toggle-submenu-btn').forEach(function (btn) {
                const targetSelector = btn.getAttribute('data-bs-target');
                const target = document.querySelector(targetSelector);

                // When shown
                target.addEventListener('shown.bs.collapse', function () {
                    btn.querySelector('i').style.transform = 'rotate(180deg)';
                });

                // When hidden
                target.addEventListener('hidden.bs.collapse', function () {
                    btn.querySelector('i').style.transform = 'rotate(0deg)';
                });
            });
        });
    </script>



