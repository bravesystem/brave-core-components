@page
@using BRaVe_Portal.Models
@model BRaVe_Portal.Pages.Distributions.Items.DistributionItemsModel

@{
    ViewData["Title"] = "Item Management";
    Layout = "_SectionMenu";
}

@section SubMenuBar {
    <div class="page-tabs">
        <a asp-page="/Distributions/DistributionsType" class="tab-item">Distribution Types</a>
        <a asp-page="/Distributions/DistributionKits" class="tab-item">Kit Types</a>
        <a asp-page="/Distributions/Items/DistributionItems" class="tab-item active">Item Types</a>
    </div>
}
<div class="mb-3 text-end">
    <button type="button"
            class="btn btn-success btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#DistributionItemModal"
            onclick="openAddItemModal()">
        <i class="fa fa-plus"></i> Add Item
    </button>
</div>

<!-- Search -->
<form method="get" class="mb-3 d-flex justify-content-center">
    <div class="position-relative" style="max-width:500px;width:100%;">
        <input name="SearchTerm"
               type="text"
               class="form-control shadow-sm rounded-pill ps-5 pe-4"
               placeholder="Search Items..."
               value="@Model.SearchTerm" />

        <span class="position-absolute top-50 start-0 translate-middle-y ps-3">
            <i class="bi bi-search" style="color:#004080;"></i>
        </span>
    </div>

    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    <input type="hidden" name="CurrentPage" value="1" />
</form>

@if (TempData["ItemsMessage"] != null)
{
    var status = TempData["ItemStatus"]?.ToString();

    <div class="alert @(status == "success" ? "alert-success" : "alert-danger")">
        @TempData["ItemsMessage"]
    </div>
}
<div style="background: linear-gradient(90deg, #e3f2fd, #bbdefb); border-left:4px solid #1e88e5; padding:12px; margin-top:10px; font-size:14px; color:#0d47a1; border-radius:4px;">
    <strong>ℹ Note:</strong>
    SKU refers (Stock Keeping Unit) is a unique code used to identify and track each item in the distribution.
</div>
<!-- Page Size + Pagination -->
<div class="d-flex justify-content-between align-items-center mb-2 p-3 small">
    <form method="get" class="d-inline-flex align-items-center mb-0">
        <span>Show</span>

        <select name="PageSize"
                class="form-select form-select-sm"
                style="width:auto;display:inline-block;margin:0 4px;"
                onchange="this.form.submit()">

            <option value="5" selected="@(Model.PageSize == 5)">5</option>
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="25" selected="@(Model.PageSize == 25)">25</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>

        </select>

        <span>entries</span>

        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
        <input type="hidden" name="CurrentPage" value="1" />
    </form>

    <!-- Pagination -->
    <nav>
        <ul class="pagination justify-content-center mb-0">

            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./DistributionItems"
                   asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-SearchTerm="@Model.SearchTerm">Previous</a>
            </li>

       @for (int i = 1; i <= Model.TotalPages; i++)
{
    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
        <a class="page-link" asp-page="./DistributionItems"
           asp-route-CurrentPage="@i"
           asp-route-PageSize="@Model.PageSize"
           asp-route-SearchTerm="@Model.SearchTerm">@i</a>
    </li>
}

<li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
    <a class="page-link" asp-page="./DistributionItems"
       asp-route-CurrentPage="@(Model.CurrentPage + 1)"
       asp-route-PageSize="@Model.PageSize"
       asp-route-SearchTerm="@Model.SearchTerm">Next</a>
</li>

        </ul>
    </nav>
</div>

<div asp-validation-summary="All" class="alert alert-danger"></div>

@if ((Model.FilteredItems?.Count ?? 0) > 0)
{

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white fw-bold">
            Manage Items
        </div>

        <div class="card-body p-0">

            <table class="table table-bordered table-hover align-middle mb-0" id="itemsTable">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Notes</th>
                        <th>Source</th>
                        <th>SKU</th>
                        <th>QR Code</th>
                        <th>External Id</th>
                        <th>Activity Date</th>
                        <th>Status</th>
                        <th>Edit</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.FilteredItems)
                    {

                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Notes</td>
                         
                            <td>
                                @{
                                    var typeName = item.Source switch
                                    {
                                        "E" => "External",
                                        "I" => "Internal",
                                        _ => "Unknown"
                                    };
                                }
                                @typeName
                            </td>
                            <td>@item.SKU</td>
                            <td>@item.QRCode</td>
                            <td>@item.ExternalId</td>
                            <td>
                                @((item.UpdatedOn ?? item.CreatedOn).ToString("yyyy-MM-dd"))
                                <br />
                                <small class="text-muted">
                                    @(item.UpdatedOn == null ? "Created" : "Updated")
                                </small>
                            </td>
                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fa fa-check"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa fa-times"></i>
                                    </span>
                                }



                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        style="background-color:#198754;color:white"
                                        data-bs-toggle="modal"
                                        data-bs-target="#DistributionItemModal"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-notes="@item.Notes"
                                        data-source="@item.Source"
                                        data-sku="@item.SKU"
                                        data-qrcode="@item.QRCode"
                                        data-externalid="@item.ExternalId"
                                        data-isactive="@item.IsActive.ToString().ToLower()"
                                        data-tenantid="@item.TenantId">

                                    <i class="fa fa-edit"></i>
                                </button>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>
