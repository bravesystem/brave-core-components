}

<a class="btn btn-sm btn-outline-secondary"
   style="background-color:#198754;color:ghostwhite"
   asp-page="/Distributions/DistributionKits">
    Back to Kits
</a>

@* <div>
    <partial name="_AddActivityModal" model="Model.UpdatedDistributionItemKit" />
</div> *@

<div class="modal fade" id="DistributionItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="SaveDistributionItem">

                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" id="Id" name="UpdatedItem.Id" />
                    <input type="hidden" id="TenantId" name="UpdatedItem.TenantId" />

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" id="Name" name="UpdatedItem.Name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <input class="form-control" id="Notes" name="UpdatedItem.Notes" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Source</label>
                        <select class="form-select"
                                id="Source"
                                name="UpdatedItem.Source"
                                onchange="toggleExternalId()"
                                required>
                            <option value="">-- Select Source --</option>
                            <option value="E">External</option>
                            <option value="I">Internal</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">SKU</label>
                        <input class="form-control" id="SKU" name="UpdatedItem.SKU" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">QR Code</label>
                        <input class="form-control" id="QRCode" name="UpdatedItem.QRCode" />
                    </div>
                    <div class="mb-3" id="externalIdGroup">
                        <label class="form-label">External Id</label>
                        <input class="form-control" id="ExternalId" name="UpdatedItem.ExternalId" />
                    </div>
                    <div class="form-check">
                        <!-- keep hidden to always submit false if unchecked -->
                        <input type="hidden" name="IsActive" value="false" />
                        <input class="form-check-input"
                               type="checkbox"
                               id="IsActive"
                               name="UpdatedItem.IsActive"
                               value="true" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Toggle ExternalId field visibility based on Source
            function toggleExternalId() {
                const source = document.getElementById("Source").value;
                const group = document.getElementById("externalIdGroup");

                if (source === "E") {
                    group.style.display = "block";
                } else {
                    group.style.display = "none";
                    document.getElementById("ExternalId").value = "";
                }
            }

            // Open Add Modal
            window.openAddItemModal = function () {
                document.getElementById("modalTitle").innerText = "Add Item";
                document.getElementById("Id").value = "";
                document.getElementById("TenantId").value = "";
                document.getElementById("Name").value = "";
                document.getElementById("Notes").value = "";
                document.getElementById("Source").value = "";
                document.getElementById("SKU").value = "";
                document.getElementById("QRCode").value = "";
                document.getElementById("ExternalId").value = "";
                document.getElementById("IsActive").checked = true;

                toggleExternalId();
            };

            // Modal edit handler
            const modal = document.getElementById("DistributionItemModal");

            if (modal) {
                modal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;

                    if (!button || !button.getAttribute("data-id")) return;

                    document.getElementById("modalTitle").innerText = "Edit Item";

                    document.getElementById("Id").value = button.getAttribute("data-id");
                    document.getElementById("TenantId").value = button.getAttribute("data-tenantid");
                    document.getElementById("Name").value = button.getAttribute("data-name");
                    document.getElementById("Notes").value = button.getAttribute("data-notes");

                    const src = button.getAttribute("data-source");
                    document.getElementById("Source").value = src;

                    document.getElementById("SKU").value = button.getAttribute("data-sku");
                    document.getElementById("QRCode").value = button.getAttribute("data-qrcode");
                    document.getElementById("ExternalId").value = button.getAttribute("data-externalid");

                    const isActiveAttr = button.getAttribute("data-isactive");
                    document.getElementById("IsActive").checked =
                        isActiveAttr && isActiveAttr.toLowerCase() === "true";

                    toggleExternalId();
                });
            }

            // Bind Source dropdown change
            const sourceDropdown = document.getElementById("Source");
            if (sourceDropdown) {
                sourceDropdown.addEventListener("change", toggleExternalId);
            }

            // Initial state
            toggleExternalId();

            // Safer form submit logging (targets modal form only)
            const modalForm = document.querySelector("#DistributionItemModal form");

            if (modalForm) {
                modalForm.addEventListener("submit", function () {
                    console.log(
                        "IsActive checked:",
                        document.getElementById("IsActive").checked
                    );
                });
            }

        });
    </script>
}