@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Pages.Distributions.DistributionsMappingModel
@{
    CoreLookups coreLookups = (CoreLookups)ViewData["CoreLookups"];
    var lookups = coreLookups?.UOM ?? new List<LookupItemDto>();
}
<div class="modal fade" id="AddItemToDistributionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-sm border-0 rounded-3">

            <div class="modal-header border-0 bg-light py-3">
                <h5 class="modal-title fw-bold">Add Item To Distribution: @Model.DistributionTitle  : @Model.Description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form method="post"
                      asp-page-handler="AddDistributionKitItem"
                      id="AddDistributionKitItemForm">
                    <input type="hidden" asp-for="Description" />
                    <input type="hidden" asp-for="DistributionTitle" />
                    <input type="hidden" asp-for="DistributionExternalId" />
                    <input type="hidden" asp-for="distributionId" />
                    <input type="hidden" asp-for="TenantId" />

                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Distribution Description</label>
                        <input class="form-control" value="@Model.Description" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Item</label>

                        <select asp-for="SelectedItemIds" class="form-select">
                            <option value="">-- Select Item --</option>

                            @foreach (var item in Model.Items)
                            {
                                <option value="@item.Id">
                                    @item.Name - @item.Notes
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity</label>
                        <input class="form-control" asp-for="Quantity" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Measure</label>
                        <div class="input-group">
                            <input class="form-control" asp-for="Measure" />

                            <select asp-for="UoM" class="form-select">
                                <option value="">-- UoM --</option>
                                @foreach (var s in lookups)
                                {
                                    <option value="@s.Id">@s.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-4 d-flex justify-content-end gap-2">

                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-save me-1"></i> Save
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>