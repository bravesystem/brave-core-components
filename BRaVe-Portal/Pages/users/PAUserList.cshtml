@page
@using BRaVe_Portal.Models
@using BRaVe_Portal.Models.DTOs
@model BRaVe_Portal.Pages.Users.PAUserListModel
@{
    var coreLookups = ViewData["CoreLookups"] as CoreLookups;
    var lookups = coreLookups?.Roles ?? new List<LookupItemDto>();
    ViewData["Title"] = "Mission Users";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
   
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white fw-bold">MISSION USERS</div>

    <div class="card-body p-3">
        <!-- Search input -->
        <div class="mb-3 d-flex justify-content-center">
            <div class="position-relative" style="max-width: 500px; width: 100%;">
                <input id="searchInput" type="text"
                       class="form-control shadow-sm rounded-pill ps-5 pe-4"
                       placeholder="Search users..."
                       value="@Model.SearchTerm" />
                <span class="position-absolute top-50 start-0 translate-middle-y ps-3">
                    <i class="bi bi-search" style="color:#004080;"></i>
                </span>
            </div>
        </div>

        <!-- Page size + pagination -->
        <div class="d-flex justify-content-between align-items-center mb-2 p-3 small">
            <form method="get" class="d-inline-flex align-items-center mb-0">

                @Html.AntiForgeryToken()

                <span>Show</span>
                <select asp-for="PageSize" class="form-select form-select-sm"
                        style="width:auto;display:inline-block;margin:0 4px;"
                        onchange="this.form.submit()">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>
                <input type="hidden" asp-for="SearchTerm" />
                <input type="hidden" asp-for="CurrentPage" />
            </form>

            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage - 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?CurrentPage=@i&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?CurrentPage=@(Model.CurrentPage + 1)&PageSize=@Model.PageSize&SearchTerm=@Model.SearchTerm">Next</a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Users Table -->
        <table class="table table-bordered table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Update Roles</th>
                
                </tr>
            </thead>
            <tbody>
                @if (Model.FilteredUsers.Any())
                {
                    foreach (var user in Model.FilteredUsers)
                    {
                        <tr>
                            <td>@user.ProfileName</td>
                            <td>@user.Email</td>                    
                            <td>@string.Join(" , ", user.Roles)</td>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary edit-user-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        data-name="@user.ProfileName"
                                        data-user-id="@user.UserId"
                                        data-email="@user.Email"
                                        data-roles="@string.Join(',', user.Roles)"
                                data-role-ids="@string.Join(',', user.RoleIds)">
                                    <i class="fa fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No users found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!--Modal to edit user roles-->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit User Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm" method="post">
                    @Html.AntiForgeryToken()
                 @*    <input type="hidden" name="SelectedUserId" id="modalUserId" /> *@
                    <input type="hidden" name="ExistingRoleIdsRaw" id="existingRoleIds" />
                    <input type="hidden" name="SelectedUserId" id="SelectedUserId2" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" class="form-control" id="modalUserName"  readonly>
                    </div>

             
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" id="modalUserEmail" name="SelectedUserId" readonly>
                    </div>


                    <div class="mb-3">
                        <label class="form-label fw-semibold">Assign Roles:</label>
                        <select id="modalRolesSelect" name="SelectedRoleIds" class="form-select" multiple required>
                            @foreach (var c in lookups)
                            {
                                <option value="@c.Id">@c.Text</option>
                            }
                        </select>
                    </div>


                    <!-- Selected Roles List -->
                    <div id="selectedRolesList" class="mt-3">
                        <h6>Current Roles:</h6>
                        <div id="rolesList" class="d-flex flex-wrap gap-2"></div>

                    </div>




                    <div class="text-end">
                        <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const nameInput = document.getElementById('modalUserName');
        const userId = document.getElementById('SelectedUserId2');
        const emailInput = document.getElementById('modalUserEmail');
        const rolesSelect = document.getElementById('modalRolesSelect');
        const rolesList = document.getElementById('rolesList');
        const selectedRolesList = document.getElementById('selectedRolesList');

        // Initialize Choices.js once
        const choices = new Choices(rolesSelect, {
            removeItemButton: true,
            searchEnabled: true,
            placeholderValue: 'Select roles...',
            shouldSort: false,
            itemSelectText: '',
            position: 'bottom',
        });

        // Store instance for reuse
        rolesSelect.choicesjs = choices;

        // When "Edit" button clicked
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.edit-user-btn');
            if (!btn) return;

            userId.value = btn.getAttribute('data-user-id');
            // Set name/email fields
            nameInput.value = btn.getAttribute('data-name');
            emailInput.value = btn.getAttribute('data-email');

            // Get roles for this user
            const roles = btn.getAttribute('data-roles').split(',').map(r => r.trim()).filter(r => r);
            const roleIds = btn.getAttribute('data-role-ids');
            document.getElementById('existingRoleIds').value = roleIds || "";


            // Reset dropdown
            choices.removeActiveItems();

            // Select roles in the dropdown
            roles.forEach(roleText => {
                const option = Array.from(rolesSelect.options).find(
                    opt => opt.text.trim().toLowerCase() === roleText.toLowerCase()
                );
                if (option) {
                    choices.setChoiceByValue(option.value);
                }
            });

            // --- Show original roles only (static display) ---
            rolesList.innerHTML = ''; // clear existing badges
            if (roles.length > 0) {
                selectedRolesList.style.display = 'block';
                roles.forEach(role => {
                    const span = document.createElement('span');
                    span.classList.add('badge', 'bg-primary', 'p-2');
                    span.textContent = role;
                    rolesList.appendChild(span);
                });
            } else {
                selectedRolesList.style.display = 'none';
            }
        });
    });
</script>



@section Scripts {
    <script>
        const searchInput = document.getElementById("searchInput");
        let debounceTimer;

        searchInput.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                const searchTerm = encodeURIComponent(searchInput.value);
                const pageSize = @Model.PageSize;
                const currentPage = 1; // reset to first page on new search
                const url = `?SearchTerm=${searchTerm}&PageSize=${pageSize}&CurrentPage=${currentPage}`;

                fetch(url)
                    .then(resp => resp.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");

                        // Replace table
                        const newTable = doc.querySelector("#usersTable").outerHTML;
                        document.querySelector("#usersTable").outerHTML = newTable;

                        // Replace pagination
                        const newPagination = doc.querySelector(".pagination").outerHTML;
                        document.querySelector(".pagination").outerHTML = newPagination;
                    });
            }, 400);
        });
    </script>


}

