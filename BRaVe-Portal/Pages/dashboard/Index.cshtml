    <!-- Charts -->
    <div class="row g-3">

        <div class="col-lg-6">
            <div class="chart-card p-3">
                <h6 class="mb-2">Registrations by demographic</h6>
                <canvas id="chartRegistrations"></canvas>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-card p-3">
                <h6 class="mb-2">Enrollment and Assistance</h6>
                <canvas id="chartDistribution"></canvas>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-card p-3">
                <h6 class="mb-2">Assistances by demographic</h6>
                <canvas id="chartAssistances"></canvas>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-card p-3">
                <h6 class="mb-2">Assessments by status</h6>
                <canvas id="chartAssessmentsStatus"></canvas>
            </div>
        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@* @section Scripts { *@

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    <script>

        let charts = {};

        const COLORS = {
            primary: '#3B82F6',
            success: '#10B981',
            warning: '#F59E0B',
            danger: '#EF4444',
            info: '#06B6D4',
            purple: '#8B5CF6',
            pink: '#EC4899',
            dark: '#1F2937'
        };

        function destroyChart(id) {
            if (charts[id]) {
                charts[id].destroy();
                charts[id] = null;
            }
        }

        async function loadDashboardCharts() {

            const programSelect = document.getElementById('filterProgram');
            const missionSelect = document.getElementById('missionFilter');
            const startDate = document.getElementById('filterDateFrom').value;
            const endDate = document.getElementById('filterDateTo').value;

            const params = new URLSearchParams();

            if (missionSelect.value && missionSelect.value !== 'all') {
                params.append('tenantId', missionSelect.value);
            }

            if (programSelect.value && programSelect.value !== 'all') {
                params.append('programId', programSelect.value);
            }

            params.append('startDate', startDate);
            params.append('endDate', endDate);

            try {
                    const res = await fetch(`/Dashboard?handler=GraphData&${params.toString()}`);

                    if (!res.ok) {
                        console.error("Bad response:", res.status);
                        return;
                    }

                    let data;
                    try {
                        data = await res.json();
                    } catch {
                        console.error("Invalid JSON response");
                        return;
                    }

                const demo = data.graphMaleFemaleChildren ?? {};
                const heads = data.graphFemaleChildOtherAsHead ?? {};
                const risk = data.graphRiskAssessment ?? {};
                const dist = data.graphDistributionAssistance ?? {};

                // Get canvas elements safely
                const regCtx = document.getElementById('chartRegistrations');
                const assistCtx = document.getElementById('chartAssistances');
                const statusCtx = document.getElementById('chartAssessmentsStatus');
                const distCtx = document.getElementById('chartDistribution');

                // REGISTRATIONS (BAR)
                destroyChart('reg');
                charts.reg = new Chart(regCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Males', 'Females', 'Children'],
                        datasets: [{
                            data: [
                                demo.males ?? 0,
                                demo.females ?? 0,
                                demo.children ?? 0
                            ],
                            backgroundColor: [
                                COLORS.primary,
                                COLORS.pink,
                                COLORS.warning
                            ],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });

                // HOUSEHOLD HEADS (DOUGHNUT)
                destroyChart('assist');
                charts.assist = new Chart(assistCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['FemaleHead', 'ChildHead', 'Other'],
                        datasets: [{
                            data: [
                                heads.femaleHead ?? 0,
                                heads.childHead ?? 0,
                                heads.other ?? 0
                            ],
                            backgroundColor: [
                                COLORS.danger,
                                COLORS.purple,
                                COLORS.info
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });

                // RISK STATUS (DOUGHNUT)
                destroyChart('status');
                charts.status = new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: [
                            'Created',
                            'InProgress',
                            'Approved',
                            'Rejected',
                            'PendingReview'
                        ],
                        datasets: [{
                            data: [
                                risk.created ?? 0,
                                risk.inProgress ?? 0,
                                risk.approved ?? 0,
                                risk.rejected ?? 0,
                                risk.pendingReview ?? 0
                            ],
                            backgroundColor: [
                                COLORS.dark,
                                COLORS.warning,
                                COLORS.success,
                                COLORS.danger,
                                COLORS.info
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });

                // DISTRIBUTION (BAR)
                destroyChart('dist');
                charts.dist = new Chart(distCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Enrolled', 'Received'],
                        datasets: [{
                            data: [
                                dist.totalHouseholdsEnrolled ?? 0,
                                dist.totalHouseholdsReceived ?? 0
                            ],
                            backgroundColor: [
                                COLORS.primary,
                                COLORS.success
                            ],
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });

                // METRICS
              
                // document.getElementById('metricBeneficiaries').innerText =
                //     (demo.males ?? 0) + (demo.females ?? 0);
                //   debugger;

                // document.getElementById('metricAssistances').innerText =
                //     dist.totalHouseholdsReceived ?? 0;

                // document.getElementById('metricAssessments').innerText =
                //     (risk.created ?? 0) +
                //     (risk.approved ?? 0) +
                //     (risk.inProgress ?? 0) +
                //     (risk.rejected ?? 0) +
                //     (risk.pendingReview ?? 0);

            } catch (err) {
                console.error("Failed to load dashboard charts:", err);
            }
        }

        async function loadProgramsByMission() {

            const missionSelect = document.getElementById('missionFilter');
            const programSelect = document.getElementById('filterProgram');

            programSelect.innerHTML = `<option>Loading...</option>`;

            const missionId = missionSelect.value !== 'all'
                ? missionSelect.value
                : null;

            const url = missionId
                ? `/Dashboard?handler=ProgramsByMission&missionId=${missionId}`
                : `/Dashboard?handler=ProgramsByMission`;

            const res = await fetch(url);
            const programs = await res.json();

            programSelect.innerHTML = `<option value="all">All programs</option>`;

            programs.forEach(p => {
                programSelect.innerHTML +=
                    `<option value="${p.programId}">${p.title}</option>`;
            });
        }


        document.addEventListener('DOMContentLoaded', () => {

            document
                .getElementById('missionFilter')
                .addEventListener('change', loadProgramsByMission);

            document
                .getElementById('applyBtn')
                .addEventListener('click', loadDashboardCharts);

            loadProgramsByMission();
            loadDashboardCharts();
        });

        //loadProgramsByMission();
        //loadDashboardCharts();


    </script>

@* } *@