@page

@using BRaVe_Portal.Helpers


@{
    ViewData["Title"] = "Dashboard";
}
@model BRaVe_Portal.Pages.Dashboard.IndexModel

<link rel="stylesheet" href="~/css/brave-dashboard.css" asp-append-version="true" />


<div class="brave-dashboard">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="mb-0">Dashboard</h4>
            <small class="text-muted">Overview  </small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <small class="text-muted">Updated: <span id="lastUpdated">-</span></small>

            <!-- same Bootstrap styling, uses tag helper to link to Razor Page /RawData -->
            <a asp-page="RawData/rawdata" class="btn btn-primary btn-sm ms-2">
                <i class="fa-solid fa-table-list me-1"></i> View Raw Data
            </a>
        </div>

    </div>

   @*  <div style="background-color:#e8f4fd; border-left:4px solid #2196F3; padding:10px; margin-top:10px; font-size:14px; color:#333;">
        <strong style="color:#2196F3;">ℹ Note:</strong>
        This dashboard is a placeholder and does not reflect actual data. It is still under development.
    </div> *@

    <br />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }



    @{
        var pendingList = Model.Programs
        .Select(p => new
        {
            Program = p,
            Assessment = Model.Ongoing_Assessments.FirstOrDefault(a => a.AssessmentId == p.AssessmentId)
        ?? Model.Decided_Assessments.FirstOrDefault(a => a.AssessmentId == p.AssessmentId)
        })
        .Where(x =>
        x.Assessment != null &&
        UserRoles.UserHasPendingJob(User, x.Assessment.Status)
        )
        .ToList();
    }

    @if (pendingList.Any())
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-3">

            <div>
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong> You have @pendingList.Count pending task(s)</strong>
            </div>

            <button class="btn btn-sm btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#pendingTasksModal">
                View Tasks
            </button>
        </div>
    }

    @if (pendingList.Any())
    {
        <div class="modal fade" id="pendingTasksModal" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            Pending Tasks (@pendingList.Count)
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <ul class="list-group">
                            @foreach (var item in pendingList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">

                                    <div>
                                        Program Name:<strong> @item.Program.Title</strong><br />
                                        <small class="text-muted">
                                            Status: @item.Assessment.Status
                                        </small>
                                    </div>

                                    <a asp-page="/Assessments/EditAssessment"
                                       asp-route-assessmentId="@item.Assessment.AssessmentId"
                                       asp-route-statusId="@item.Assessment.StatusId"
                                       class="btn btn-sm btn-primary">
                                        View Task
                                    </a>

                                </li>
                            }
                        </ul>

                    </div>

                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="card mb-3 filter-card">
        <div class="card-body">
            <form id="filtersForm" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Mission</label>
                    <select id="missionFilter" class="form-select">

                      @if (User.IsInRole(EnumUserRoles.Admin.ToString()))
                      {
                        <option value="all">All Missions</option>
                      }
                        

                        @foreach (var m in Model.Missions)
                        {
                            <option value="@m.MissionId">@m.Name</option>
                        }
                    </select>

                </div>
                <div class="col-md-4">
                    <label class="form-label">Program</label>
                    <select id="filterProgram"
                            name="SelectedProgramId"
                            class="form-select modern-select">

                        @if (User.IsInRole(EnumUserRoles.Admin.ToString())
                                                || User.IsInRole(EnumUserRoles.PA.ToString())
                                                || User.IsInRole(EnumUserRoles.PM.ToString()))
                        {
                            <option value="all" selected="@(Model.SelectedProgramId == null)">
                                All programs
                            </option>
                        }

                        @foreach (var program in Model.Programs)
                        {
                            <option value="@program.ProgramId" selected="@(program.ProgramId == Model.SelectedProgramId)">
                                @program.Title
                            </option>
                        }
                    </select>
                </div>



                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input id="filterDateFrom" type="date" class="form-control"
                           value="@DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input id="filterDateTo" type="date" class="form-control"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-md-2">
                    <button id="applyBtn" type="button" class="btn btn-primary w-100">Apply filters</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Metrics -->
