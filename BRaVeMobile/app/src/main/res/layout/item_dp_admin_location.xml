<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/llWrapper">
    <TextView
        android:id="@+id/tvOrder"
        android:textStyle="bold"
        android:layout_marginBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select one (searchable)"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddressFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Extra address / notes under the list -->
    <EditText
        android:id="@+id/etExtraAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Additional address info"
        android:imeOptions="actionDone"
        android:layout_marginTop="8dp" />


    <TextView
        android:id="@+id/tvRequired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Required"
        android:textStyle="bold"
        android:textColor="@android:color/holo_red_dark"
        android:visibility="gone"/>
</LinearLayout>
