<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brave_blue"
    android:padding="24dp"
    tools:context=".ui.InputPinPage">

    <!-- ⚪ White Rounded Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="40dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        android:backgroundTint="@android:color/white"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="556dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- 🔒 Title -->
            <TextView
                android:id="@+id/tvInputPinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Enter Your PIN"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="@color/brave_blue"
                android:textStyle="bold" />

            <!-- ✨ Subtitle -->
            <TextView
                android:id="@+id/tvInputPinSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Please set a secure 4-digit PIN"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 🔢 Pin Pad -->

            <!-- 💬 Optional Message -->
            <intl.iom.bravemobile.ui.PinPadView
                android:id="@+id/pinPad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvHintMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Action Button: Go to Activities -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabChangePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Change Pin"
            app:srcCompat="@drawable/ic_refresh_24"
            app:tint="?attr/colorOnPrimaryContainer"
            app:backgroundTint="?attr/colorPrimaryContainer"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
