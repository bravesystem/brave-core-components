<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:dividerPadding="12dp">

        <!-- 🧭 Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:dividerPadding="6dp">

                <!-- Code -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/numbers_24dp"
                        app:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACT-2025-001"
                        android:textColor="@color/brave_blue"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Community Profiling – Garissa County"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="6dp" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baseline survey to assess community vulnerability and resources."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp" />

                <!-- Dates -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/calendar_month_24dp"
                        app:tint="@color/brave_blue"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvActivityPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  –  Open-ended"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!--<TextView
                        android:id="@+id/tvStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 Oct 2025"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/brave_blue" />

                    <TextView
                        android:id="@+id/tvEndDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  –  Open-ended"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />-->
                </LinearLayout>

                <!-- 🔧 Compatibility container (needed for Java code) -->
                <LinearLayout
                    android:id="@+id/endDateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        
        <!-- 🧩 Enumerator whitelist Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"

            android:backgroundTint="?attr/colorSurfaceContainer"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person_24"
                        android:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvWhitelistHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enumerator Whitelist"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold"
                        android:textColor="@color/brave_blue"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvNoWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No whitelist"
                    android:gravity="center_horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"/>
                
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- 🧩 Preferences Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:backgroundTint="?attr/colorSurfaceContainer">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/settings_input_component_24dp"
                        android:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvPreferencesHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Preferences"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold"
                        android:textColor="@color/brave_blue" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="true"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvNoPreferences"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No preferences available"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🧾 Consents Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:backgroundTint="?attr/colorSurfaceContainer"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/order_approve_24dp"
                        app:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvConsentsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consents"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold"
                        android:textColor="@color/brave_blue" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvConsents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvNoConsents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No consents recorded"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 📊 Data Points Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:backgroundTint="?attr/colorSurfaceContainer"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/data_check_24dp"
                        app:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvDataPointsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Points"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold"
                        android:textColor="@color/brave_blue" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDataPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvNoDataPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No data points"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- 📊 Survey Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:backgroundTint="?attr/colorSurfaceContainer"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/data_check_24dp"
                        app:tint="@color/brave_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvSurveysHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surveys"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold"
                        android:textColor="@color/brave_blue"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSurveys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvNoSurveys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No surveys"
                    android:gravity="center_horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ⚙︝ Actions -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:flexWrap="wrap"
            app:justifyContent="center"
            app:alignItems="center"
            app:alignContent="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrations"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrations"
                android:textColor="@color/brave_blue"
                app:strokeColor="@color/brave_blue"
                app:icon="@drawable/ic_registration_24"
                app:iconTint="@color/brave_blue"
                app:iconPadding="8dp"
                app:cornerRadius="24dp"
                android:layout_margin="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifications"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biometric Record Check"
                android:textColor="@color/brave_blue"
                app:strokeColor="@color/brave_blue"
                app:icon="@drawable/ic_check_24"
                app:iconTint="@color/brave_blue"
                app:iconPadding="8dp"
                app:cornerRadius="24dp"
                android:layout_margin="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btndistributions"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distributions"
                android:textColor="@color/brave_blue"
                app:strokeColor="@color/brave_blue"
                app:icon="@drawable/ic_shelter_24"
                app:iconTint="@color/brave_blue"
                app:iconPadding="8dp"
                app:cornerRadius="24dp"
                android:layout_margin="6dp" />

        </com.google.android.flexbox.FlexboxLayout>

    </LinearLayout>
</ScrollView>
