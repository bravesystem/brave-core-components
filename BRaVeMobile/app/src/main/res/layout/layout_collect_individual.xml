<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Names -->
    <TextView
        android:id="@+id/tvNamesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Individual Names"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etFirstName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="First name"
        android:inputType="textCapWords"
        app:layout_constraintTop_toBottomOf="@id/tvNamesLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etMiddleName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Middle name (optional)"
        android:inputType="textCapWords"
        app:layout_constraintTop_toBottomOf="@id/etFirstName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etLastName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Last name"
        android:inputType="textCapWords"
        app:layout_constraintTop_toBottomOf="@id/etMiddleName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DOB & Age triplet -->
    <TextView
        android:id="@+id/tvDobAgeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date of Birth / Age"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/etLastName"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/FrameDob"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDobAgeLabel">

        <!-- EditText takes remaining space -->
        <EditText
            android:id="@+id/etDob"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="YYYY-MM-DD (tap to pick)"
            android:focusable="false"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingEnd="8dp" />

        <!-- Clear button on the right -->

        <Button
            android:id="@+id/btnClearDob"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textSize="16sp"
            android:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/FrameDob"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etAgeYears"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Years"
            android:inputType="number" />

        <EditText
            android:id="@+id/etAgeMonths"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Months"
            android:inputType="number"
            android:layout_marginStart="8dp" />

        <EditText
            android:id="@+id/etAgeDays"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Days"
            android:inputType="number"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Relationship & Gender -->

    <TextView
        android:id="@+id/tvRelLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Relationship"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/rowAge"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spRelationship"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvRelLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/spGender"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/tvGenLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gender"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/spRelationship"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spGender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvGenLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Photo + Biometric -->
    <TextView
        android:id="@+id/tvPhotoBioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Photo &amp; Biometric"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/spGender"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/rowPhotoBio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvPhotoBioLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@android:drawable/ic_menu_report_image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvBiometricBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BIO"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_round"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_gravity="start|top"
                android:layout_margin="6dp"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCapturePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_add_a_photo_24"
                app:iconGravity="textStart"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical" />

            <Button
                android:id="@+id/btnCaptureBiometric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_fingerprint_24"
                app:iconGravity="textStart"
                android:layout_marginStart="12dp"
                android:layout_gravity="center_vertical" />

        </LinearLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/tvNoBioReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reason Biometric Was Not Captured"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/rowPhotoBio"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spNoBioReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvNoBioReason"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etNoBioReasonOther"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="If Other, specify reason"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="2"
        android:gravity="top|start"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/spNoBioReason"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />





</androidx.constraintlayout.widget.ConstraintLayout>