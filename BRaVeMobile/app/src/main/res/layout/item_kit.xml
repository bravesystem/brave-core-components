<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- LEFT ACCENT -->
        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/brave_blue" />

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRecordType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record type: Kit"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_marginBottom="6dp" />

            <!-- HEADER: KIT TITLE + TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvKitTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="kit-1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- TOTAL BADGE (same field, new look) -->
                <TextView
                    android:id="@+id/tvKitTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brave_blue"
                    android:background="@drawable/bg_badge_kits"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- KIT ID -->
            <TextView
                android:id="@+id/tvKitId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: AAA"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginTop="6dp" />

            <!-- SOFT DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="#E5E7EB" />

            <!-- ITEMS HEADER -->
            <TextView
                android:id="@+id/tvItemsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Items"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:letterSpacing="0.08" />

            <!-- ITEMS LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
