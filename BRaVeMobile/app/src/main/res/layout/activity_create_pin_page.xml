<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brave_blue"
    android:padding="24dp"
    tools:context=".ui.CreatePinPage">

    <!-- ⚪ White Rounded Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="40dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        android:backgroundTint="@android:color/white"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <!-- 🔒 Title -->
            <TextView
                android:id="@+id/tvCreatePinTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a PIN"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textStyle="bold"
                android:textColor="@color/brave_blue"
                android:layout_marginBottom="12dp" />

            <!-- ✨ Subtitle -->
            <TextView
                android:id="@+id/tvCreatePinSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set a 4-digit PIN for secure access"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="24dp" />

            <!-- 🔢 Pin Pad -->
            <intl.iom.bravemobile.ui.PinPadView
                android:id="@+id/pinPad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- 💬 Optional Helper Message -->
            <TextView
                android:id="@+id/tvHelperMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
