<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gpsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp">

    <!-- Title + coordinates -->
    <TextView
        android:id="@+id/tvGpsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location Coordinates (Lat, Long)"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGpsResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/no_gps_collected"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp" />

    <!-- Buttons row -->
    <LinearLayout
        android:id="@+id/gpsButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnGpsCollect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Collect" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnGpsClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear" />
    </LinearLayout>

</LinearLayout>
