<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Photo (left) -->

    <!-- Top line: Household ID + biometric badge -->
    <ImageView
        android:id="@+id/imgPhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_report_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.053" />

    <TextView
        android:id="@+id/tvIndividualId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="#: —"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/imgPhoto"
        app:layout_constraintTop_toTopOf="@id/imgPhoto"
        app:layout_constraintEnd_toStartOf="@id/tvBiometricBadge"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvBiometricBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BIO"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_badge_round"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvIndividualId"/>

    <!-- Full name -->
    <TextView
        android:id="@+id/tvFullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Name: —"
        app:layout_constraintStart_toStartOf="@id/tvIndividualId"
        app:layout_constraintTop_toBottomOf="@id/tvIndividualId"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Registration token (optional; default GONE) -->
    <TextView
        android:id="@+id/tvRegistrationToken"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Token: —"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvFullName"
        app:layout_constraintTop_toBottomOf="@id/tvFullName"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Age / Gender / Relationship row -->
    <LinearLayout
        android:id="@+id/rowMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/tvFullName"
        app:layout_constraintTop_toBottomOf="@id/tvRegistrationToken"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Age: -"/>

        <TextView
            android:id="@+id/tvGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="   •   Gender: -"
            android:layout_marginStart="8dp"/>


    </LinearLayout>

    <TextView
        android:id="@+id/tvRelationship"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="   •   Rel: -"
        app:layout_constraintStart_toStartOf="@id/tvFullName"
        app:layout_constraintTop_toBottomOf="@id/rowMeta"
        />


    <!-- Error message (badge style). Static for now. -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:singleLine="false"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tvFullName"
        app:layout_constraintTop_toBottomOf="@id/tvRelationship"
        android:layout_marginTop="8dp"/>
<!-- android:background="@drawable/bg_badge_error_round" -->
    <!-- Actions row: Edit + Delete (horizontal, aligned end) -->
    <LinearLayout
        android:id="@+id/rowActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/tvFullName"
        app:layout_constraintTop_toBottomOf="@id/tvErrorMessage"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            app:iconGravity="textStart"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            app:iconGravity="textStart"
            android:layout_marginLeft="12dp" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
