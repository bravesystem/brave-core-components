<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:backgroundTint="?attr/colorSurfaceContainerHigh">

    <!-- Use FrameLayout to overlay a badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Your original content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 🔷 Activity Code -->
            <TextView
                android:id="@+id/tvCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACT-2025-001"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/brave_blue"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 🧾 Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Community Profiling - Garissa County"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <!-- 💬 Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Baseline data collection among households and local institutions."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="6dp" />

            <!-- 📅 Dates -->
            <TextView
                android:id="@+id/tvDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active • Started 10 Oct 2025"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/brave_blue"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <!-- ⚙️ Actions -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDnld"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    app:strokeColor="@color/brave_blue"
                    android:textColor="@color/brave_blue"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_downloading_24"
                    app:iconTint="@color/brave_blue"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendData"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync"
                    android:layout_marginStart="12dp"
                    android:textColor="@android:color/white"
                    app:backgroundTint="@color/brave_blue"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_sync_24"
                    app:iconTint="@android:color/white"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔒 Lock badge (overlay, initially gone; toggle visible for closed activities) -->
        <ImageView
            android:id="@+id/ivLockBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_round"
            android:padding="3dp"
            android:src="@drawable/ic_lock_16"
            android:visibility="gone" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>