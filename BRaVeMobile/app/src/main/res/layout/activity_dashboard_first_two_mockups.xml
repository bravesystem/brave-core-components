<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========== MOCKUP 1: KPI ROW ========== -->
        <TextView
            android:id="@+id/kpi_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="KPI Summary"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Scroll sideways to view all the cards"
            android:textSize="12sp"
            android:textColor="#AA0000"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minWidth="600dp">

                <include
                    layout="@layout/item_dashboard_kpi_card"
                    android:id="@+id/card_households"
                    android:layout_marginEnd="12dp" />

                <include
                    layout="@layout/item_dashboard_kpi_card"
                    android:id="@+id/card_individuals"
                    android:layout_marginEnd="12dp" />

                <include
                    layout="@layout/item_dashboard_kpi_card"
                    android:id="@+id/card_surveys"
                    android:layout_marginEnd="12dp" />

                <include
                    layout="@layout/item_dashboard_kpi_card"
                    android:id="@+id/card_assistance"
                    android:layout_marginEnd="12dp" />

                <include
                    layout="@layout/item_dashboard_kpi_card"
                    android:id="@+id/card_errors" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ========== MOCKUP 1: BIOMETRIC VERIFICATION (4 states) ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Biometric Record Check"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/verification_label_create"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Create"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary" />
                        <TextView
                            android:id="@+id/verification_count_create"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/verification_label_processing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Processing"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary" />
                        <TextView
                            android:id="@+id/verification_count_processing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/verification_label_no_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No match"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary" />
                        <TextView
                            android:id="@+id/verification_count_no_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/verification_label_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Match"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary" />
                        <TextView
                            android:id="@+id/verification_count_match"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4-segment bar (weights set from code) -->
                <LinearLayout
                    android:id="@+id/verification_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <View android:id="@+id/verification_bar_create"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#9E9E9E" />
                    <View android:id="@+id/verification_bar_processing" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FF9800" />
                    <View android:id="@+id/verification_bar_no_match" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F44336" />
                    <View android:id="@+id/verification_bar_match"    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#4CAF50" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== MOCKUP 2: SURVEY COMPLETION ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Survey completion (required only)"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/survey_completion_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </androidx.cardview.widget.CardView>

        <!-- ========== MOCKUP 2: BIOMETRIC & PHOTO COMPLIANCE ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Individual – Biometric &amp; photo (when required)"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Biometric"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />
                    <ProgressBar
                        android:id="@+id/biometric_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="85" />
                    <TextView
                        android:id="@+id/biometric_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="85% all collected, 15% some missing" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photo"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />
                    <ProgressBar
                        android:id="@+id/photo_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="94" />
                    <TextView
                        android:id="@+id/photo_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="94% collected, 6% missing" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
