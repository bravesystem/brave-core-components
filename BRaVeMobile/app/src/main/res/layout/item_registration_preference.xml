<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:padding="12dp">


    <!-- Left: DataPoint text -->
    <TextView
        android:id="@+id/tvPreference"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Question text"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvPreferenceType"
        android:layout_marginEnd="8dp"/>

    <!-- Right-top: type -->
    <TextView
        android:id="@+id/tvPreferenceType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Right-bottom: required badge -->
    <TextView
        android:id="@+id/tvPreferenceValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Required"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_badge_round"
        app:layout_constraintEnd_toEndOf="@id/tvPreferenceType"
        app:layout_constraintTop_toBottomOf="@id/tvPreferenceType"
        android:layout_marginTop="6dp"/>




</androidx.constraintlayout.widget.ConstraintLayout>