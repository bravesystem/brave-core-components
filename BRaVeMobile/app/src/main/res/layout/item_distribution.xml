<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- LEFT ACCENT (VISUAL IDENTITY) -->
        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="@color/brave_blue" />

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distribution Title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- META ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <!-- ID -->
                <TextView
                    android:id="@+id/tvId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ID: —"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- KITS BADGE -->
                <TextView
                    android:id="@+id/tvKitsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kits: 0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brave_blue"
                    android:background="@drawable/bg_badge_kits"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <!-- DIVIDER (SOFT, MODERN)
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="#E5E7EB" /> -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetEnrollments"
                style="@style/Widget.Material3.Button"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text=""
                android:textColor="@android:color/white"
                app:backgroundTint="@color/brave_blue"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_downloading_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white" />

            <!-- ADDITIONAL INFO -->
            <TextView
                android:id="@+id/tvAdditionalInfoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Additional info: (placeholder)"
                android:textSize="13sp"
                android:textColor="#475569"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
