<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Enumerator icon -->
        <ImageView
            android:id="@+id/iconEnumerator"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_person_24"
            android:contentDescription="Enumerator Icon"
            app:tint="@color/brave_blue" />

        <!-- Info section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Name and Code -->
            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code: EN-001"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

            <!-- Note -->
            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note: Senior Enumerator"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <!-- Status row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvActiveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@android:color/holo_green_dark" />

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • Updated 2h ago"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"
                    android:paddingStart="4dp" />
            </LinearLayout>

            <!-- Expiry -->
            <TextView
                android:id="@+id/tvExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires in 24h"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Type badge (Supervisor / Enumerator) -->
        <TextView
            android:id="@+id/tvTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUP"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:padding="6dp"
            android:background="@drawable/rounded_badge"
            android:backgroundTint="@color/brave_blue" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
