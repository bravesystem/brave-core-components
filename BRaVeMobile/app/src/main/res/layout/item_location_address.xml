<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- List of address parts (each row can be a MaterialAutoCompleteTextView later) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddressFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Extra address / notes under the list -->
    <EditText
        android:id="@+id/etExtraAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Additional address info"
        android:imeOptions="actionDone"
        android:layout_marginTop="8dp"
        tools:text="Apartment, suite, unit" />

</LinearLayout>
